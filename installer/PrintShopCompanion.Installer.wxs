<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX v5 installer definition for PrintShop Companion.

  Installs the WPF app to %ProgramFiles%\PrintShop\Companion\, the worker
  service to the same folder, the bundled PDFium.dll and SumatraPDF.exe
  binaries, and registers the printshopcompanion:// URL scheme with Windows.
  Adds a per-user shortcut to the Start Menu and (optionally) creates the
  per-user Startup shortcut for auto-launch.

  WiX v5 builds with: wix build PrintShopCompanion.Installer.wxs -o PrintShopCompanion.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="PrintShop Companion"
    Manufacturer="PrintShop"
    Version="$(var.BuildVersion)"
    UpgradeCode="A6F0B7D2-1A7C-4C9E-9B47-7C0F3B6A7D2E"
    Language="1033"
    Codepage="1252"
    Scope="perMachine">

    <SummaryInformation
      Description="PrintShop Companion installer"
      Manufacturer="PrintShop" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of PrintShop Companion is already installed." />
    <Media Id="1" Cabinet="PrintShopCompanion.cab" EmbedCab="yes" />

    <!-- Per-machine install is set via Scope="perMachine" on the Package
         element (WiX v5 renamed InstallScope to Scope; the older
         InstallScope attribute is rejected with WIX0004 on WiX 5.0.x). -->

    <Feature Id="Complete" Title="PrintShop Companion" Level="1">
      <Feature Id="AppFeature" Title="PrintShop Companion app" Level="1">
        <ComponentGroupRef Id="AppComponents" />
        <ComponentGroupRef Id="RuntimeComponents" />
        <ComponentGroupRef Id="ProtocolRegistration" />
      </Feature>
      <Feature Id="WorkerFeature" Title="Background worker service (optional)" Level="1">
        <ComponentGroupRef Id="WorkerComponents" />
      </Feature>
      <!-- v0.7.12: MockBackendFeature removed. PrintShopCompanion.Backend.Mock
           no longer exists — the mock backend was superseded by the ASP.NET
           PrintShopCompanion.Backend web project (a server, not a desktop
           binary). The ComponentGroup shipped a File reference to a binary
           the publish output never contained, so WiX failed WIX0103 on every
           MSI build that got this far. -->
    </Feature>

    <!-- Basic install — no custom UI dialog. WiX v5 moved WixUI_FeatureTree to a
         separate extension (WixToolset.UI.wixext) that requires an extra NuGet
         reference. For the initial release we use the default install flow. -->

    <!-- Phase 10: the <Property Id="INSTALLDIR"> and <Property Id="STARTMENUFOLDER">
         rows that used to stand here were the ROOT CAUSE of MSI error 1606
         ("Could not access network location PrintShop" -> fatal 1603 at
         CostFinalize). Every Directory-table row is a property at install time;
         a Property-table row with the same name OVERRIDES the Directory-tree
         resolution. STARTMENUFOLDER's value was the drive-less relative string
         "PrintShop", which Windows Installer interprets as a network location —
         verified from the run-12 package's verbose log (49 s resolution timeout,
         then 1606) and its MSI Property table. Directory properties must be
         resolved from the Directory tree ONLY (see docs/PHASE10_ROOT_CAUSE_1606.md);
         CI enforces this with a preflight collision check (msi-preflight.ps1). -->
    <CustomAction Id="SetPerUserStartup" Directory="INSTALLDIR" ExeCommand='[INSTALLDIR]PrintShopCompanion.exe --register-autostart' Return="asyncNoWait" />
    <!-- Phase 10: the per-user Startup shortcut created by the register
         autostart custom action is NOT owned by this per-machine MSI (it
         lives in the installing user's %AppData% Startup folder). Without
         the cleanup action below it would survive uninstall and silently
         point at a deleted exe on every login. The uninstall-time action
         runs BEFORE the files are removed (Before=InstallValidate) while
         the exe still exists, only on full uninstall (REMOVE equals ALL),
         and never breaks the uninstall (Return=ignore). Per-user
         limitation is symmetric: a per-machine uninstall cannot clean up
         OTHER users' Startup folders. -->
    <CustomAction Id="UnsetPerUserStartup" Directory="INSTALLDIR" ExeCommand='[INSTALLDIR]PrintShopCompanion.exe --unregister-autostart' Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="SetPerUserStartup" After="InstallFinalize" Condition="NOT Installed" />
      <Custom Action="UnsetPerUserStartup" Before="InstallValidate" Condition='REMOVE ~= "ALL"' />
    </InstallExecuteSequence>
  </Package>

  <!-- Phase 10: INSTALLDIR is the LEAF directory so it resolves
       deterministically to the documented install path
       C:\Program Files\PrintShop\Companion — with NO Property-table override
       (the override was the error-1606 root cause, see
       docs/PHASE10_ROOT_CAUSE_1606.md). Every [INSTALLDIR] reference in this
       file (shortcut target/working dir, URL-protocol registry values,
       autostart custom action, worker service ImagePath) expands to the leaf.
       STARTMENUFOLDER resolves from ProgramMenuFolder (per-machine:
       C:\ProgramData\Microsoft\Windows\Start Menu\Programs\PrintShop). -->
  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="VendorDir" Name="PrintShop">
        <Directory Id="INSTALLDIR" Name="Companion" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="STARTMENUFOLDER" Name="PrintShop" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="AppComponents" Directory="INSTALLDIR">
      <!-- Phase 10 (found by the CI installation matrix, run 46143838268):
           the MSI previously shipped ONLY the exe/appsettings/manifest/
           SumatraPDF/worker - the SELF-CONTAINED publish payload (the ~200
           .NET runtime + dependency DLLs) was never installed, so the
           installed PrintShopCompanion.exe could not start (host error
           0x8000808A, zero DLLs in the install dir). The smoke never caught
           it because Phase 9 installs always died at 1606/1603 BEFORE the
           launch step.

           Phase 10 design: the <Files> element below (a ComponentGroup-level
           child in WiX v5; it auto-creates its component) ships the WHOLE
           publish output recursively - exe, worker, appsettings.json,
           manifest, all runtime/dependency DLLs. PDBs are deleted from the
           publish output by CI before the build (WiX v5's Files element has
           no Exclude attribute). The exe and worker exe therefore have NO
           explicit <File> elements here - that also avoids duplicate-target
           errors. -->
      <Component Id="AppShortcut" Guid="A7F0B7D2-1A7C-4C9E-9B47-7C0F3B6A7D43" KeyPath="yes">
        <!-- Registry keypath component for the non-advertised shortcut:
             the shortcut does not need to live in the exe's file component
             because its Target is a literal [INSTALLDIR] path. HKMU resolves
             to HKLM for this per-machine package (ICE-clean). -->
        <RegistryKey Root="HKMU" Key="Software\PrintShop\Companion">
          <RegistryValue Type="integer" Name="StartMenuShortcut" Value="1" />
        </RegistryKey>
        <!-- Phase 10 correction of the Phase 9 note below: the 1606 failure
             was NOT caused by shortcut advertisement - the non-advertised
             shortcut still failed with 1606 in the run-12 package. The real
             root cause was the Property/Directory Id collision (see
             docs/PHASE10_ROOT_CAUSE_1606.md). The non-advertised shortcut is
             kept: it is the correct authoring for a self-contained app and
             needs no source resolution. -->
        <Shortcut Id="StartMenuShortcut"
                   Directory="STARTMENUFOLDER"
                   Name="PrintShop Companion"
                   WorkingDirectory="INSTALLDIR"
                   Advertise="no"
                   Target="[INSTALLDIR]PrintShopCompanion.exe"
                   Description="Open PrintShop Companion" />
      </Component>
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <ComponentGroup Id="RuntimeComponents" Directory="INSTALLDIR">
      <!-- Bundled SumatraPDF.exe — the primary PDF renderer. It renders PDFs
           internally and submits them to the Windows print spooler via
           `SumatraPDF.exe -silent -print-to <printer> <pdf>`. -->
      <Component Id="SumatraPDF" Guid="A7F0B7D2-1A7C-4C9E-9B47-7C0F3B6A7D34">
        <File Id="SumatraPDF.exe"
              Source="$(var.RepoRoot)\installer\redist\SumatraPDF.exe" />
      </Component>
    </ComponentGroup>

    <!-- Register the printshopcompanion:// URL scheme. Per-user only (HKCU) so no admin needed. -->
    <ComponentGroup Id="ProtocolRegistration" Directory="INSTALLDIR">
      <Component Id="ProtocolRegistration" Guid="A7F0B7D2-1A7C-4C9E-9B47-7C0F3B6A7D35" KeyPath="yes">
        <RegistryKey Root="HKCU" Key="Software\Classes\printshopcompanion">
          <RegistryValue Type="string" Value="URL:PrintShop Companion" />
          <RegistryValue Type="string" Name="URL Protocol" Value="" />
          <RegistryKey Key="DefaultIcon">
            <RegistryValue Type="string" Value="[INSTALLDIR]PrintShopCompanion.exe,0" />
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value='"[INSTALLDIR]PrintShopCompanion.exe" "%1"' />
          </RegistryKey>
        </RegistryKey>
      </Component>
      <!-- Phase 0 audit fix: the SaaS pairing dialog emits
           printshop://pair?ticket=…&shop=… (POST /api/v1/companion/pairing/begin
           returns pairingUrl with this scheme). The legacy scheme alone meant a
           click on the website's deep link did NOTHING unless the user had the
           legacy scheme registered by another product. Register BOTH; the app
           parses either. -->
      <Component Id="ProtocolRegistrationPrintshop" Guid="A7F0B7D2-1A7C-4C9E-9B47-7C0F3B6A7D36" KeyPath="yes">
        <RegistryKey Root="HKCU" Key="Software\Classes\printshop">
          <RegistryValue Type="string" Value="URL:PrintShop Companion" />
          <RegistryValue Type="string" Name="URL Protocol" Value="" />
          <RegistryKey Key="DefaultIcon">
            <RegistryValue Type="string" Value="[INSTALLDIR]PrintShopCompanion.exe,0" />
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value='"[INSTALLDIR]PrintShopCompanion.exe" "%1"' />
          </RegistryKey>
        </RegistryKey>
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="WorkerComponents" Directory="INSTALLDIR">
      <!-- Phase 10: the worker exe itself ships via the AppComponents <Files>
           glob (same publish dir, avoids duplicate file targets). This group
           keeps only the service-registration registry stub. NOTE: the
           service is still NOT actually installed (no service custom action -
           pre-existing Phase 0-9 state, documented in the report). -->
      <Component Id="WorkerServiceInstall" Guid="A7F0B7D2-1A7C-4C9E-9B47-7C0F3B6A7D41" KeyPath="yes">
        <!-- Service install / uninstall is done via a deferred custom action (omitted here). -->
        <RegistryKey Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\PrintShopCompanionWorker">
          <RegistryValue Type="string" Name="ImagePath" Value="[INSTALLDIR]PrintShopCompanion.Worker.exe" />
          <RegistryValue Type="integer" Name="Start" Value="2" />
          <RegistryValue Type="string" Name="Description" Value="Background print-job processor for PrintShop Companion" />
        </RegistryKey>
      </Component>
    </ComponentGroup>

    <!-- v0.7.12: MockBackendComponents removed with MockBackendFeature — the
         binary no longer exists (see the Feature comment above). -->
  </Fragment>
</Wix>
