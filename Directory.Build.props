<Project>

  <PropertyGroup>
  <!--
    Multi-target by default:
      net10.0          — platform-neutral. Used by unit/integration tests so the whole
                         OS-agnostic suite (queue, pairing, update, sync, contracts) RUNS
                         on any OS (Linux CI/sandbox), not just cross-compiles.
      net10.0-windows  — full Windows surface (System.Printing, DPAPI, WPF). Used by the
                         WPF App (single-TFM) and by tests' windows TFM on Windows CI.
    Projects that are inherently Windows-only (PrintShopCompanion.App) override this to
    a single net10.0-windows TargetFramework. Windows-only source files are excluded from
    the net10.0 compilation in each csproj and gated with #if WINDOWS inside shared files.
  -->
  <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>

  <!-- WINDOWS symbol gates Windows-only code paths inside multi-targeted files. -->
  <DefineConstants Condition="'$(TargetFramework)' == 'net10.0-windows'">$(DefineConstants);WINDOWS</DefineConstants>
  <!-- RID pinning per host OS (disk hygiene): the default build copies EVERY
       RID's native binaries (PDFium/SkiaSharp: arm64, x86, android, browser...)
       into every bin/ folder — hundreds of MB per tree. PrintEXE tests run on
       linux-x64 in this sandbox/CI and production targets win-x64, so pin the
       copy set to the host RID. Windows CI overrides where needed (publish -r win-x64). -->
  <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' AND '$(OS)' == 'Unix'">linux-x64</RuntimeIdentifier>
  <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' AND '$(OS)' == 'Windows_NT'">win-x64</RuntimeIdentifier>
  <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Authors>PrintShop</Authors>
    <Product>PrintShop Companion</Product>
    <Copyright>Copyright (c) PrintShop</Copyright>
    <PackageProjectUrl>https://github.com/Arjunyadavsoma/PrintEXE</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Arjunyadavsoma/PrintEXE</RepositoryUrl>

    <!--
      Version is now overridable from CI via the BUILD_VERSION env var.
      Local builds fall back to the hardcoded 0.4.3 below.
      The GitHub Actions workflow sets BUILD_VERSION from the git tag
      (e.g. v0.4.3 -> 0.4.3) BEFORE calling dotnet build, so a release
      build's assembly version always matches its tag.

      This was the root cause of the "update installs but version stays
      the same" bug: the workflow published a v0.4.2 tag with assembly
      version 0.4.1.0 hardcoded here, so the auto-updater downloaded
      the new files but the assembly version never changed and the
      updater kept reporting "update available".
    -->
    <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
    <Version Condition="'$(BUILD_VERSION)' == ''">0.7.5</Version>

    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>

    <!--
      Allow building the net10.0-windows WPF solution on NON-Windows hosts
      (Linux CI / agent sandboxes). Without this, restore cannot download the
      Microsoft.Windows*.App ref packs and `dotnet build` fails immediately,
      which is exactly what PHASE_STATUS.md's "tests pass on Linux" claim
      collided with (Phase 0 audit). Windows-only execution still requires a
      real Windows machine — this property only enables cross-compiling.
    -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- Suppress stylistic warnings that don't block the build.

         CA1716: namespace name 'PrintShopCompanion.Shared.Constants' etc. conflicts
                 with the VB.NET 'Shared' keyword. The companion is C#-only, so the
                 cross-language concern is moot. Renaming the namespaces would be
                 a much bigger refactor than the warning warrants.

         CA1861: 'prefer static readonly over constant array arguments'. Triggered
                 by the mock backend's `new[] { ... }` array passed to a method that
                 is called on every request. Will be addressed in a follow-up but
                 is not blocking. -->
    <NoWarn>$(NoWarn);CA1716;CA1861</NoWarn>
  </PropertyGroup>

  <!-- Global usings. With UseWPF=true on Infrastructure, the default implicit
       usings change and System.IO is NOT included automatically. Adding it here
       as a global using for all projects so we don't need 'using System.IO;'
       in every file that uses Path, File, Directory, MemoryStream, etc. -->
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <!-- CSproj-level shared settings -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
    <PublishSingleFile Condition="'$(PublishSingleFile)' == ''">false</PublishSingleFile>
  </PropertyGroup>


  <!--
    Disk hygiene (sandbox/CI): PDFtoImage/SkiaSharp ship native binaries for
    many RIDs (arm64, x86, android, browser, musl...). The default build copies
    ALL of them into every bin/ folder across every project x TFM — hundreds of
    MB per tree. PrintEXE only ever RUNS on linux-x64 (tests) and win-x64
    (production), so trim the copies to those two. The NuGet cache keeps all
    RID packs (restore unchanged; Windows CI unaffected).
  -->
</Project>
