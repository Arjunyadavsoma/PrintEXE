<Project>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Authors>PrintShop</Authors>
    <Product>PrintShop Companion</Product>
    <Copyright>Copyright (c) PrintShop</Copyright>
    <PackageProjectUrl>https://github.com/Arjunyadavsoma/PrintEXE</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Arjunyadavsoma/PrintEXE</RepositoryUrl>

    <!--
      Version is now overridable from CI via the BUILD_VERSION env var.
      Local builds fall back to the hardcoded 0.4.3 below.
      The GitHub Actions workflow sets BUILD_VERSION from the git tag
      (e.g. v0.4.3 -> 0.4.3) BEFORE calling dotnet build, so a release
      build's assembly version always matches its tag.

      This was the root cause of the "update installs but version stays
      the same" bug: the workflow published a v0.4.2 tag with assembly
      version 0.4.1.0 hardcoded here, so the auto-updater downloaded
      the new files but the assembly version never changed and the
      updater kept reporting "update available".
    -->
    <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
    <Version Condition="'$(BUILD_VERSION)' == ''">0.4.3</Version>

    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>

    <!-- Suppress stylistic warnings that don't block the build.

         CA1716: namespace name 'PrintShopCompanion.Shared.Constants' etc. conflicts
                 with the VB.NET 'Shared' keyword. The companion is C#-only, so the
                 cross-language concern is moot. Renaming the namespaces would be
                 a much bigger refactor than the warning warrants.

         CA1861: 'prefer static readonly over constant array arguments'. Triggered
                 by the mock backend's `new[] { ... }` array passed to a method that
                 is called on every request. Will be addressed in a follow-up but
                 is not blocking. -->
    <NoWarn>$(NoWarn);CA1716;CA1861</NoWarn>
  </PropertyGroup>

  <!-- Global usings. With UseWPF=true on Infrastructure, the default implicit
       usings change and System.IO is NOT included automatically. Adding it here
       as a global using for all projects so we don't need 'using System.IO;'
       in every file that uses Path, File, Directory, MemoryStream, etc. -->
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <!-- CSproj-level shared settings -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
    <PublishSingleFile Condition="'$(PublishSingleFile)' == ''">false</PublishSingleFile>
  </PropertyGroup>

</Project>
