<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>PrintShopCompanion.Worker</RootNamespace>
    <AssemblyName>PrintShopCompanion.Worker</AssemblyName>
    <OutputType>Exe</OutputType>
    <UserSecretsId>printshop-companion-worker</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.2" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.EventLog" Version="4.0.0" />

    <!-- Vulnerable-transitive overrides — same as App and Infrastructure. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrintShopCompanion.Core\PrintShopCompanion.Core.csproj" />
    <ProjectReference Include="..\PrintShopCompanion.Infrastructure\PrintShopCompanion.Infrastructure.csproj" />
    <ProjectReference Include="..\PrintShopCompanion.Shared\PrintShopCompanion.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
