<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme — no external dependencies. Uses standard WPF colors. -->
    <Color x:Key="SystemAccentColor">#0F7B6C</Color>

    <SolidColorBrush x:Key="BrandPrimaryBrush"  Color="#0F7B6C" />
    <SolidColorBrush x:Key="BrandAccentBrush"   Color="#1AB8A4" />
    <SolidColorBrush x:Key="BrandDangerBrush"   Color="#D13438" />
    <SolidColorBrush x:Key="BrandWarningBrush"  Color="#FFA62D" />
    <SolidColorBrush x:Key="BrandSuccessBrush"  Color="#2E9C53" />
    <SolidColorBrush x:Key="StatusPendingBrush"   Color="#FFA62D" />
    <SolidColorBrush x:Key="StatusPrintingBrush"  Color="#0F7B6C" />
    <SolidColorBrush x:Key="StatusCompletedBrush" Color="#2E9C53" />
    <SolidColorBrush x:Key="StatusFailedBrush"    Color="#D13438" />

    <SolidColorBrush x:Key="ApplicationBackgroundBrush"  Color="#FAFAFA" />
    <SolidColorBrush x:Key="CardBackgroundBrush"         Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush"             Color="#E5E5E5" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"  Color="#1F1F1F" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#5F5F5F" />
    <SolidColorBrush x:Key="ControlAltBrush"             Color="#F3F3F3" />
</ResourceDictionary>
