<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <!-- Light theme: pull WPF-UI's light resources and then layer our overrides. -->
        <ResourceDictionary Source="pack://application:,,,/WPF-UI;component/Themes/Light.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Color x:Key="SystemAccentColor">#0F7B6C</Color>

    <SolidColorBrush x:Key="ApplicationBackgroundBrush"  Color="#FAFAFA" />
    <SolidColorBrush x:Key="CardBackgroundBrush"         Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush"             Color="#E5E5E5" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"  Color="#1F1F1F" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#5F5F5F" />
    <SolidColorBrush x:Key="ControlAltBrush"             Color="#F3F3F3" />
</ResourceDictionary>
