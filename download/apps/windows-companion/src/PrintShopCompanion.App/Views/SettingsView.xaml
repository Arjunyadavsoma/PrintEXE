<UserControl
    x:Class="PrintShopCompanion.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PrintShopCompanion.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:SettingsViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Text="Behaviour, appearance, diagnostics, and device management." Opacity="0.7" Margin="0,0,0,24" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="App" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <CheckBox Content="Minimise to tray on close" IsChecked="{Binding MinimizeToTrayOnClose}" Margin="0,0,0,8" />
                    <CheckBox Content="Run on Windows startup"    IsChecked="{Binding AutoStartWithWindows}" Margin="0,0,0,8" />
                    <CheckBox Content="Follow system theme"      IsChecked="{Binding FollowSystemTheme}" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Theme:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox SelectedItem="{Binding Theme}" Width="160">
                            <ComboBoxItem Content="system" />
                            <ComboBoxItem Content="light" />
                            <ComboBoxItem Content="dark" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Printing" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Renderer:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox SelectedItem="{Binding Renderer}" Width="160">
                            <ComboBoxItem Content="pdfium" />
                            <ComboBoxItem Content="sumatra" />
                            <ComboBoxItem Content="gdi" />
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Text="Selected printer" Opacity="0.7" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding SelectedPrinter}" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Device" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding ShopName, StringFormat='Shop: {0}'}" />
                    <TextBlock Text="{Binding DeviceId, StringFormat='Device ID: {0}'}" Opacity="0.7" />
                    <TextBlock Text="{Binding AppVersion, StringFormat='App version: {0}'}" Opacity="0.7" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" Content="Open log folder" Command="{Binding OpenLogDirCommand}" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Revoke this PC"
                                Margin="8,0,0,0" Command="{Binding RevokeDeviceCommand}"
                                Foreground="{DynamicResource BrandDangerBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Style="{StaticResource PrimaryButton}" Content="Save" Command="{Binding SaveCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
