<Window
    x:Class="PrintShopCompanion.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:nav="clr-namespace:PrintShopCompanion.App.Views"
    xmlns:vm="clr-namespace:PrintShopCompanion.App.ViewModels"
    Title="PrintShop Companion"
    Width="960" Height="640" MinWidth="800" MinHeight="540"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    WindowStyle="SingleBorderWindow"
    ResizeMode="CanResize"
    Closing="OnClosing">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left navigation rail -->
        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="20,20,20,12">
                    <TextBlock Text="PrintShop" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrandPrimaryBrush}" />
                    <TextBlock Text="Companion" FontSize="14" Opacity="0.7" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Margin="20,12" Opacity="0.55" FontSize="11"
                           x:Name="VersionLabel" />

                <StackPanel Margin="0,0,0,0">
                    <Button Style="{StaticResource NavRailItem}" Content="Setup"
                            Click="Nav_Click" Tag="Setup" x:Name="NavSetup"/>
                    <Button Style="{StaticResource NavRailItem}" Content="Dashboard"
                            Click="Nav_Click" Tag="Dashboard" x:Name="NavDashboard"/>
                    <Button Style="{StaticResource NavRailItem}" Content="Printers"
                            Click="Nav_Click" Tag="Printers" x:Name="NavPrinters"/>
                    <Button Style="{StaticResource NavRailItem}" Content="Print Queue"
                            Click="Nav_Click" Tag="PrintQueue" x:Name="NavPrintQueue"/>
                    <Button Style="{StaticResource NavRailItem}" Content="Settings"
                            Click="Nav_Click" Tag="Settings" x:Name="NavSettings"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Active screen -->
        <ContentControl Grid.Column="1" x:Name="ContentArea" Margin="24,24,24,24" />
    </Grid>
</Window>
