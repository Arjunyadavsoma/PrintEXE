<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme — web-parity (printshop-saas globals.css light values) -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush"  Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundBrush"         Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush"             Color="#E5E7EB" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"  Color="#1F2937" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="ControlAltBrush"             Color="#F9FAFB" />
    <SolidColorBrush x:Key="DangerBrush"                 Color="#BE222A" />
    <SolidColorBrush x:Key="DangerSoftBrush"             Color="#FFE7E4" />
    <SolidColorBrush x:Key="SuccessBrush"                Color="#007F3D" />
    <SolidColorBrush x:Key="SuccessSoftBrush"            Color="#E0F5E5" />
    <SolidColorBrush x:Key="WarningBrush"                Color="#E48E26" />
    <SolidColorBrush x:Key="WarningSoftBrush"            Color="#FFE8CC" />
    <SolidColorBrush x:Key="InfoBrush"                   Color="#006E9E" />
    <SolidColorBrush x:Key="InfoSoftBrush"               Color="#DBF3FF" />
    <SolidColorBrush x:Key="BrandBrush"                  Color="#2858CD" />
    <SolidColorBrush x:Key="BrandSoftBrush"              Color="#E1EFFF" />
</ResourceDictionary>
