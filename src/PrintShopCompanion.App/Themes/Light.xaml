<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme — matches printshop-saas -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush"  Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundBrush"         Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush"             Color="#E5E7EB" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"  Color="#1F2937" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="ControlAltBrush"             Color="#F9FAFB" />
    <SolidColorBrush x:Key="DangerBrush"                 Color="#DC2626" />
    <SolidColorBrush x:Key="DangerSoftBrush"             Color="#FEF2F2" />
    <SolidColorBrush x:Key="SuccessBrush"                Color="#16A34A" />
    <SolidColorBrush x:Key="SuccessSoftBrush"            Color="#F0FDF4" />
</ResourceDictionary>
