<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme — matches printshop-saas globals.css light mode -->

    <SolidColorBrush x:Key="ApplicationBackgroundBrush"  Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundBrush"         Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush"             Color="#EBEBEB" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"  Color="#232323" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#8E8E8E" />
    <SolidColorBrush x:Key="ControlAltBrush"             Color="#F5F5F5" />
    <SolidColorBrush x:Key="DangerBrush"                 Color="#DC2626" />
    <SolidColorBrush x:Key="DangerSoftBrush"             Color="#FEF2F2" />
    <SolidColorBrush x:Key="SuccessBrush"                Color="#16A34A" />
    <SolidColorBrush x:Key="SuccessSoftBrush"            Color="#F0FDF4" />
</ResourceDictionary>
