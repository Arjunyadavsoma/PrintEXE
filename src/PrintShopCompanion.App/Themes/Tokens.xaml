<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ====================================================================
         PRINTSHOP COMPANION DESIGN SYSTEM
         Centralized design tokens. Use these everywhere; do not hardcode
         colors, fonts, sizes, or spacing in views.

         Color palette (WEB-PARITY — mirrors printshop-saas src/app/globals.css
         oklch tokens, converted to sRGB; see Core/Presentation/WebUiCatalog.cs):
           Brand      2858CD (indigo 264)  primary actions, brand identity
                                          = web brand token oklch(0.50 0.19 264)
           Accent     1A48BC (indigo hover) = web brand-hover
           Dark       1638A0 (indigo deep)  pressed/selected text
           Soft       E1EFFF (indigo tint)  = web brand-soft
           Softer     E9F2FF (indigo tint)  active nav item background
           Info       006E9E / DBF3FF       = web info (paid)
           Success    007F3D / E0F5E5       = web success (ready/completed)
           Warning    E48E26 / FFE8CC       = web warning (awaiting payment)
           Danger     BE222A / FFE7E4       = web danger (cancelled)
           Border     E5E7EB (gray-200)  card borders, divider lines
           Surface    FFFFFF              cards, panels
           Background F7F7F8              page background
           TextPrimary 111827 (gray-900)  headings
           TextBody   374151 (gray-700)  body text
           TextMuted  6B7280 (gray-500)  secondary text
           TextSubtle 9CA3AF (gray-400)  captions, micro labels
    ==================================================================== -->

    <!-- ==================== COLORS ==================== -->
    <Color x:Key="BrandColor">#2858CD</Color>
    <Color x:Key="BrandAccentColor">#1A48BC</Color>
    <Color x:Key="BrandDarkColor">#1638A0</Color>
    <Color x:Key="BrandSoftColor">#E1EFFF</Color>
    <Color x:Key="BrandSofterColor">#E9F2FF</Color>
    <Color x:Key="BrandBorderColor">#AEBEDF</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="BackgroundColor">#F7F7F8</Color>
    <Color x:Key="BorderColor">#E5E7EB</Color>
    <Color x:Key="BorderSoftColor">#F3F4F6</Color>
    <Color x:Key="TextPrimaryColor">#111827</Color>
    <Color x:Key="TextBodyColor">#374151</Color>
    <Color x:Key="TextMutedColor">#6B7280</Color>
    <Color x:Key="TextSubtleColor">#9CA3AF</Color>
    <Color x:Key="SuccessColor">#007F3D</Color>
    <Color x:Key="SuccessSoftColor">#E0F5E5</Color>
    <Color x:Key="SuccessBorderColor">#A3D8B5</Color>
    <Color x:Key="WarningColor">#E48E26</Color>
    <Color x:Key="WarningSoftColor">#FFE8CC</Color>
    <Color x:Key="WarningBorderColor">#E3B888</Color>
    <Color x:Key="WarningForegroundColor">#7A4B0E</Color>
    <Color x:Key="DangerColor">#BE222A</Color>
    <Color x:Key="DangerSoftColor">#FFE7E4</Color>
    <Color x:Key="DangerBorderColor">#E8A9A5</Color>
    <Color x:Key="InfoColor">#006E9E</Color>
    <Color x:Key="InfoSoftColor">#DBF3FF</Color>
    <Color x:Key="InfoBorderColor">#9ECAE4</Color>

    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}" />
    <SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource BrandAccentColor}" />
    <SolidColorBrush x:Key="BrandDarkBrush" Color="{StaticResource BrandDarkColor}" />
    <SolidColorBrush x:Key="BrandSoftBrush" Color="{StaticResource BrandSoftColor}" />
    <SolidColorBrush x:Key="BrandSofterBrush" Color="{StaticResource BrandSofterColor}" />
    <SolidColorBrush x:Key="BrandBorderBrush" Color="{StaticResource BrandBorderColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderSoftBrush" Color="{StaticResource BorderSoftColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextBodyBrush" Color="{StaticResource TextBodyColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextSubtleBrush" Color="{StaticResource TextSubtleColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="{StaticResource SuccessBorderColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="{StaticResource WarningBorderColor}" />
    <SolidColorBrush x:Key="WarningForegroundBrush" Color="{StaticResource WarningForegroundColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="{StaticResource DangerBorderColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="{StaticResource InfoSoftColor}" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="{StaticResource InfoBorderColor}" />

    <!-- ==================== TYPOGRAPHY ==================== -->
    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Consolas</FontFamily>

    <sys:Double x:Key="FontSizeDisplay">22</sys:Double>
    <sys:Double x:Key="FontSizeH1">16</sys:Double>
    <sys:Double x:Key="FontSizeH2">14</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeMicro">11</sys:Double>
    <sys:Double x:Key="FontSizeTiny">10</sys:Double>

    <!-- ==================== SPACING ==================== -->
    <Thickness x:Key="SpaceXS">4,4,4,4</Thickness>
    <Thickness x:Key="SpaceSM">8,8,8,8</Thickness>
    <Thickness x:Key="SpaceMD">12,12,12,12</Thickness>
    <Thickness x:Key="SpaceLG">16,16,16,16</Thickness>
    <Thickness x:Key="SpaceXL">20,20,20,20</Thickness>
    <Thickness x:Key="SpaceXXL">24,24,24,24</Thickness>

    <!-- Page-level margin (header + content) -->
    <Thickness x:Key="PageMargin">24,18</Thickness>
    <!-- Card padding -->
    <Thickness x:Key="CardPadding">20,16</Thickness>
    <!-- List row vertical padding -->
    <Thickness x:Key="ListRowPadding">12,12,12,12</Thickness>
    <!-- Button padding -->
    <Thickness x:Key="ButtonPadding">16,9,16,9</Thickness>
    <Thickness x:Key="PrimaryButtonPadding">20,10,20,10</Thickness>

    <!-- ==================== CORNER RADIUS ==================== -->
    <CornerRadius x:Key="CardRadius">10</CornerRadius>
    <CornerRadius x:Key="ControlRadius">6</CornerRadius>
    <CornerRadius x:Key="PillRadius">12</CornerRadius>
    <CornerRadius x:Key="AvatarRadius">20</CornerRadius>

</ResourceDictionary>
