<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ====================================================================
         PRINTSHOP COMPANION DESIGN SYSTEM
         Centralized design tokens. Use these everywhere; do not hardcode
         colors, fonts, sizes, or spacing in views.

         Color palette:
           Brand      D97706 (amber)      primary actions, brand identity
           Accent     F59E0B (yellow)     secondary highlights
           Soft       FEF3C7 (pale amber) hover backgrounds, pill backgrounds
           Softer     FFF7ED (light amber) active nav item background
           Border     E5E7EB (gray-200)  card borders, divider lines
           Surface    FFFFFF              cards, panels
           Background F7F7F8              page background
           TextPrimary 111827 (gray-900)  headings
           TextBody   374151 (gray-700)  body text
           TextMuted  6B7280 (gray-500)  secondary text
           TextSubtle 9CA3AF (gray-400)  captions, micro labels
           Success    16A34A (green-600)
           Warning    F59E0B (amber-500)
           Danger     DC2626 (red-600)

         Typography:
           FontFamily  Segoe UI (system default on Windows 10/11)
           Display     22   page titles (Overview, Orders, etc.)
           H1          16   card titles, shop name
           H2          14   section titles within cards
           Body        13   primary body text
           Small       12   secondary text, captions
           Micro       11   KPI labels, micro labels (UPPERCASE)
           Tiny        10   section dividers ("MENU", "SYSTEM")

         Spacing (multiples of 4):
           XS   4   pill padding vertical, small gaps
           SM   8   row gaps, button padding vertical
           MD  12   nav item margin, list row vertical
           LG  16   card padding, button padding horizontal
           XL  20   page header horizontal margin
           XXL 24   section spacing on pages

         Corner radius:
           Pill     12   small badges, status pills
           Card     10   cards, panels
           Control   6   buttons, inputs, nav items
    ==================================================================== -->

    <!-- ==================== COLORS ==================== -->
    <Color x:Key="BrandColor">#D97706</Color>
    <Color x:Key="BrandAccentColor">#F59E0B</Color>
    <Color x:Key="BrandDarkColor">#B45309</Color>
    <Color x:Key="BrandSoftColor">#FEF3C7</Color>
    <Color x:Key="BrandSofterColor">#FFF7ED</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="BackgroundColor">#F7F7F8</Color>
    <Color x:Key="BorderColor">#E5E7EB</Color>
    <Color x:Key="BorderSoftColor">#F3F4F6</Color>
    <Color x:Key="TextPrimaryColor">#111827</Color>
    <Color x:Key="TextBodyColor">#374151</Color>
    <Color x:Key="TextMutedColor">#6B7280</Color>
    <Color x:Key="TextSubtleColor">#9CA3AF</Color>
    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="SuccessSoftColor">#D1FAE5</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="DangerSoftColor">#FEE2E2</Color>
    <Color x:Key="InfoColor">#2563EB</Color>
    <Color x:Key="InfoSoftColor">#DBEAFE</Color>

    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}" />
    <SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource BrandAccentColor}" />
    <SolidColorBrush x:Key="BrandDarkBrush" Color="{StaticResource BrandDarkColor}" />
    <SolidColorBrush x:Key="BrandSoftBrush" Color="{StaticResource BrandSoftColor}" />
    <SolidColorBrush x:Key="BrandSofterBrush" Color="{StaticResource BrandSofterColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderSoftBrush" Color="{StaticResource BorderSoftColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextBodyBrush" Color="{StaticResource TextBodyColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextSubtleBrush" Color="{StaticResource TextSubtleColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="{StaticResource InfoSoftColor}" />

    <!-- ==================== TYPOGRAPHY ==================== -->
    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Consolas</FontFamily>

    <sys:Double x:Key="FontSizeDisplay">22</sys:Double>
    <sys:Double x:Key="FontSizeH1">16</sys:Double>
    <sys:Double x:Key="FontSizeH2">14</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeMicro">11</sys:Double>
    <sys:Double x:Key="FontSizeTiny">10</sys:Double>

    <!-- ==================== SPACING ==================== -->
    <Thickness x:Key="SpaceXS">4,4,4,4</Thickness>
    <Thickness x:Key="SpaceSM">8,8,8,8</Thickness>
    <Thickness x:Key="SpaceMD">12,12,12,12</Thickness>
    <Thickness x:Key="SpaceLG">16,16,16,16</Thickness>
    <Thickness x:Key="SpaceXL">20,20,20,20</Thickness>
    <Thickness x:Key="SpaceXXL">24,24,24,24</Thickness>

    <!-- Page-level margin (header + content) -->
    <Thickness x:Key="PageMargin">24,18</Thickness>
    <!-- Card padding -->
    <Thickness x:Key="CardPadding">20,16</Thickness>
    <!-- List row vertical padding -->
    <Thickness x:Key="ListRowPadding">12,12,12,12</Thickness>
    <!-- Button padding -->
    <Thickness x:Key="ButtonPadding">16,9,16,9</Thickness>
    <Thickness x:Key="PrimaryButtonPadding">20,10,20,10</Thickness>

    <!-- ==================== CORNER RADIUS ==================== -->
    <CornerRadius x:Key="CardRadius">10</CornerRadius>
    <CornerRadius x:Key="ControlRadius">6</CornerRadius>
    <CornerRadius x:Key="PillRadius">12</CornerRadius>
    <CornerRadius x:Key="AvatarRadius">20</CornerRadius>

</ResourceDictionary>
