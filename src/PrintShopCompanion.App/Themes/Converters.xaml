<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:PrintShopCompanion.App.Converters">

    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    <!-- v0.7.15: empty-state driver — Visible when count/collection is empty -->
    <conv:ZeroToVisibilityConverter x:Key="ZeroToVis" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:StringToVisibilityConverter x:Key="StringToVis" />
    <conv:InverseStringToVisibilityConverter x:Key="InverseStringToVis" />
    <!-- Web-parity presentation converters -->
    <conv:PaiseToRupeesConverter x:Key="Rupees" />
    <conv:OrderStatusLabelConverter x:Key="StatusLabel" />
    <conv:OrderStatusBrushConverter x:Key="StatusBg" />
    <conv:OrderStatusBrushConverter x:Key="StatusFg" Mode="fg" />
    <conv:OrderStatusBrushConverter x:Key="StatusBorder" Mode="border" />
    <conv:UtcToLocalTimeConverter x:Key="LocalTime" />
    <conv:BoolToLiveBrushConverter x:Key="BoolToLiveBrush" />
    <conv:FilterChipBrushConverter x:Key="ChipBg" />
    <conv:FilterChipBrushConverter x:Key="ChipFg" Mode="fg" />
</ResourceDictionary>
