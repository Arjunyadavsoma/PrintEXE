<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme — no external dependencies. Uses standard WPF colors. -->
    <Color x:Key="SystemAccentColor">#1AB8A4</Color>

    <SolidColorBrush x:Key="BrandPrimaryBrush"  Color="#0F7B6C" />
    <SolidColorBrush x:Key="BrandAccentBrush"   Color="#1AB8A4" />
    <SolidColorBrush x:Key="BrandDangerBrush"   Color="#D13438" />
    <SolidColorBrush x:Key="BrandWarningBrush"  Color="#FFA62D" />
    <SolidColorBrush x:Key="BrandSuccessBrush"  Color="#2E9C53" />
    <SolidColorBrush x:Key="StatusPendingBrush"   Color="#FFA62D" />
    <SolidColorBrush x:Key="StatusPrintingBrush"  Color="#0F7B6C" />
    <SolidColorBrush x:Key="StatusCompletedBrush" Color="#2E9C53" />
    <SolidColorBrush x:Key="StatusFailedBrush"    Color="#D13438" />

    <SolidColorBrush x:Key="ApplicationBackgroundBrush"  Color="#202020" />
    <SolidColorBrush x:Key="CardBackgroundBrush"         Color="#2B2B2B" />
    <SolidColorBrush x:Key="CardBorderBrush"             Color="#3F3F3F" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"  Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#CFCFCF" />
    <SolidColorBrush x:Key="ControlAltBrush"             Color="#2A2A2A" />
</ResourceDictionary>
