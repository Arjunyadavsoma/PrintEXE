<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme — web-parity accents (indigo brand, semantic status colors
         kept readable on dark surfaces, mirroring printshop-saas dark tokens) -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush"  Color="#111827" />
    <SolidColorBrush x:Key="CardBackgroundBrush"         Color="#1F2937" />
    <SolidColorBrush x:Key="CardBorderBrush"             Color="#374151" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"  Color="#F9FAFB" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="ControlAltBrush"             Color="#1F2937" />
    <SolidColorBrush x:Key="DangerBrush"                 Color="#F87171" />
    <SolidColorBrush x:Key="DangerSoftBrush"             Color="#451A1A" />
    <SolidColorBrush x:Key="SuccessBrush"                Color="#4ADE80" />
    <SolidColorBrush x:Key="SuccessSoftBrush"            Color="#14221A" />
    <SolidColorBrush x:Key="WarningBrush"                Color="#F5A93F" />
    <SolidColorBrush x:Key="WarningSoftBrush"            Color="#2A1E0D" />
    <SolidColorBrush x:Key="InfoBrush"                   Color="#5CB3E8" />
    <SolidColorBrush x:Key="InfoSoftBrush"               Color="#0E2230" />
    <SolidColorBrush x:Key="BrandBrush"                  Color="#7B9AF0" />
    <SolidColorBrush x:Key="BrandSoftBrush"              Color="#1A2340" />
</ResourceDictionary>
