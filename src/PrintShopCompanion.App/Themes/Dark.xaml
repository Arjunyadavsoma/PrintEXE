<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme — matches printshop-saas globals.css dark mode -->

    <SolidColorBrush x:Key="ApplicationBackgroundBrush"  Color="#232323" />
    <SolidColorBrush x:Key="CardBackgroundBrush"         Color="#333333" />
    <SolidColorBrush x:Key="CardBorderBrush"             Color="#3D3D3D" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"  Color="#FAFAFA" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#B5B5B5" />
    <SolidColorBrush x:Key="ControlAltBrush"             Color="#444444" />
    <SolidColorBrush x:Key="DangerBrush"                 Color="#F87171" />
    <SolidColorBrush x:Key="DangerSoftBrush"             Color="#3D2222" />
    <SolidColorBrush x:Key="SuccessBrush"                Color="#4ADE80" />
    <SolidColorBrush x:Key="SuccessSoftBrush"            Color="#1A3D22" />
</ResourceDictionary>
