<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- PrintShop brand colors — from globals.css OKLCH values -->
    <!-- --brand: oklch(0.646 0.222 41.116) ≈ #D97706 -->
    <!-- --brand-soft: oklch(0.95 0.05 75) ≈ #FEF3C7 -->
    <!-- --brand-foreground: oklch(0.985 0 0) ≈ #FAFAFA -->

    <SolidColorBrush x:Key="BrandPrimaryBrush"  Color="#D97706" />
    <SolidColorBrush x:Key="BrandAccentBrush"   Color="#F59E0B" />
    <SolidColorBrush x:Key="BrandSoftBrush"     Color="#FEF3C7" />
    <SolidColorBrush x:Key="BrandForegroundBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="BrandDangerBrush"   Color="#DC2626" />
    <SolidColorBrush x:Key="BrandWarningBrush"  Color="#F59E0B" />
    <SolidColorBrush x:Key="BrandSuccessBrush"  Color="#16A34A" />

    <SolidColorBrush x:Key="StatusPendingBrush"   Color="#F59E0B" />
    <SolidColorBrush x:Key="StatusPrintingBrush"  Color="#D97706" />
    <SolidColorBrush x:Key="StatusCompletedBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="StatusFailedBrush"    Color="#DC2626" />
</ResourceDictionary>
