<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- PrintShop brand colors — WEB-PARITY (printshop-saas globals.css).
         NOTE: this dictionary is merged AFTER Tokens.xaml and its
         BrandAccentBrush / BrandSoftBrush keys intentionally win there;
         every value here must therefore agree with Tokens.xaml. -->
    <SolidColorBrush x:Key="BrandPrimaryBrush"  Color="#2858CD" />
    <SolidColorBrush x:Key="BrandAccentBrush"   Color="#1A48BC" />
    <SolidColorBrush x:Key="BrandSoftBrush"     Color="#E1EFFF" />
    <SolidColorBrush x:Key="BrandForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrandDangerBrush"   Color="#BE222A" />
    <SolidColorBrush x:Key="BrandWarningBrush"  Color="#E48E26" />
    <SolidColorBrush x:Key="BrandSuccessBrush"  Color="#007F3D" />
    <SolidColorBrush x:Key="StatusPendingBrush"   Color="#E48E26" />
    <SolidColorBrush x:Key="StatusPrintingBrush"  Color="#2858CD" />
    <SolidColorBrush x:Key="StatusCompletedBrush" Color="#007F3D" />
    <SolidColorBrush x:Key="StatusFailedBrush"    Color="#BE222A" />
</ResourceDictionary>
