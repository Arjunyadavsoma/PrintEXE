{
  "Backend": {
    "BaseUrl": "https://printshop-saas-three.vercel.app",
    "ApiBasePath": "/api/v1",
    "SocketIoUrl": "https://printshop-saas-three.vercel.app/?XTransformPort=3003",
    "HubPath": "/?XTransformPort=3003",
    "HeartbeatInterval": "00:01:00",
    "HeartbeatIntervalSeconds": 60,
    "PollFallbackInterval": "00:00:02",
    "PollIntervalSeconds": 2,
    "DownloadTimeout": "00:05:00",
    "DownloadTimeoutSeconds": 300,
    "MaxPrintAttempts": 5,
    "AllowedWebOrigins": [ "https://printshop-saas-three.vercel.app" ],
    "PairingIssuer": "PrintShop",
    "BypassTlsVerification": false
  },
  "Printer": {
    "SelectedPrinter": null,
    "Renderer": "sumatra",
    "FallbackRenderers": [ "gdi" ],
    "SumatraExePath": null,
    "PrintConfirmTimeout": "00:05:00",
    "MaxAttempts": 5
  },
  "Storage": {
    "QueueDbPath": null,
    "PdfCacheDir": null,
    "LogDir": null,
    "DeviceTokenPath": null,
    "TerminalJobTtl": "7.00:00:00"
  },
  "App": {
    "MinimizeToTrayOnClose": false,
    "AutoStartWithWindows": true,
    "FollowSystemTheme": true,
    "Theme": "system"
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "File", "Args": { "path": "%APPDATA%/PrintShop/Companion/logs/companion-.log", "rollingInterval": "Day", "retainedFileCountLimit": 14 } },
      { "Name": "EventLog", "Args": { "source": "PrintShop Companion", "logName": "Application" } }
    ]
  }
}
