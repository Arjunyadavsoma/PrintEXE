<UserControl
    x:Class="PrintShopCompanion.App.Views.PrintQueueView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="24,24,24,0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Print Queue" FontSize="22" FontWeight="Bold" Foreground="#1F2937"/>
                <TextBlock Text="Local print jobs and their status" FontSize="13" Foreground="#6B7280" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Content="Refresh" Click="Refresh_Click" DockPanel.Dock="Right"
                    HorizontalAlignment="Right" Padding="16,8" FontSize="13"
                    Background="#F3F4F6" Foreground="#374151" BorderBrush="#E5E7EB"
                    BorderThickness="1" Cursor="Hand"/>
        </DockPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#E5E7EB"
                BorderThickness="1" Margin="24" Padding="20">
            <StackPanel>
                <ListView x:Name="JobList" Background="Transparent" BorderThickness="0"
                          ItemsSource="{Binding Jobs}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Title" Width="250" DisplayMemberBinding="{Binding Title}"/>
                            <GridViewColumn Header="Status" Width="100" DisplayMemberBinding="{Binding Status}"/>
                            <GridViewColumn Header="Attempts" Width="80" DisplayMemberBinding="{Binding AttemptCount}"/>
                            <GridViewColumn Header="Error" Width="200" DisplayMemberBinding="{Binding LastError}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock Text="Print queue is empty" FontSize="13" Foreground="#6B7280"
                           HorizontalAlignment="Center" Margin="0,20"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
