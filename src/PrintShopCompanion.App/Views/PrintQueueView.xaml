<UserControl
    x:Class="PrintShopCompanion.App.Views.PrintQueueView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    FontFamily="{StaticResource AppFontFamily}">

    <UserControl.Resources>
        <!-- Job status pill — web semantic colors (soft bg + strong text).
             Uncertain/unknown states get the warning amber: they REQUIRE
             operator reconciliation, so they must stand out.
             v0.7.15: hex → DynamicResource brushes (dark theme works). -->
        <Style x:Key="JobPill" TargetType="Border" BasedOn="{StaticResource StatusPill}">
            <Setter Property="Background" Value="{DynamicResource BorderSoftBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Pending">
                    <Setter Property="Background" Value="{DynamicResource BorderSoftBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Downloading">
                    <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Rendering">
                    <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Spooled">
                    <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Printed">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="ReportedPrinted">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="UncertainSpooled">
                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="OutcomeUnknown">
                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter Property="Background" Value="{DynamicResource BorderSoftBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="JobPillText" TargetType="TextBlock" BasedOn="{StaticResource StatusPillText}">
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Downloading">
                    <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Rendering">
                    <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Spooled">
                    <Setter Property="Foreground" Value="{DynamicResource BrandDarkBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Printed">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="ReportedPrinted">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="UncertainSpooled">
                    <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="OutcomeUnknown">
                    <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Operator action button — compact secondary with a semantic
             foreground. Disabled (no selection): full disabled state. -->
        <Style x:Key="OperatorButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <DockPanel Margin="{StaticResource PageMargin}">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Print Queue" Style="{StaticResource PageTitleText}"/>
                    <TextBlock Text="Local print jobs — refreshes live as jobs dispatch and print"
                               Style="{StaticResource PageSubtitleText}"/>
                </StackPanel>
                <Button Content="Refresh" Click="Refresh_Click" DockPanel.Dock="Right"
                        HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}"/>
            </DockPanel>
        </Border>

        <!-- Queue content -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="24,20,24,24">
            <StackPanel>
                <!-- Header row + summary chips -->
                <Border Background="{DynamicResource SubsurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                        Padding="20,14">
                    <DockPanel>
                        <TextBlock Text="Queue" Style="{StaticResource CardTitleText}"
                                   DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Jobs.Count, StringFormat={}{0} jobs}"
                                   Style="{StaticResource MutedText}"
                                   DockPanel.Dock="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Border Style="{StaticResource StatusPill}" Background="{DynamicResource BorderSoftBrush}" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource StatusPillText}" Foreground="{DynamicResource TextBodyBrush}">
                                    <Run Text="{Binding PendingCount, Mode=OneWay}"/><Run Text=" pending"/>
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource StatusPill}" Background="{DynamicResource BrandSoftBrush}" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource StatusPillText}" Foreground="{DynamicResource BrandDarkBrush}">
                                    <Run Text="{Binding ActiveCount, Mode=OneWay}"/><Run Text=" active"/>
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource StatusPill}" Background="{DynamicResource SuccessSoftBrush}" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource StatusPillText}" Foreground="{DynamicResource SuccessBrush}">
                                    <Run Text="{Binding PrintedCount, Mode=OneWay}"/><Run Text=" printed"/>
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource StatusPill}" Background="{DynamicResource DangerSoftBrush}">
                                <TextBlock Style="{StaticResource StatusPillText}" Foreground="{DynamicResource DangerBrush}">
                                    <Run Text="{Binding FailedCount, Mode=OneWay}"/><Run Text=" failed"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Table header row -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1"
                        Padding="20,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Job" Style="{StaticResource ColumnHeaderText}"/>
                        <TextBlock Grid.Column="1" Text="Token" Style="{StaticResource ColumnHeaderText}"/>
                        <TextBlock Grid.Column="2" Text="Pages" Style="{StaticResource ColumnHeaderText}"/>
                        <TextBlock Grid.Column="3" Text="Copies" Style="{StaticResource ColumnHeaderText}"/>
                        <TextBlock Grid.Column="4" Text="Status" Style="{StaticResource ColumnHeaderText}"/>
                        <TextBlock Grid.Column="5" Text="Last error" Style="{StaticResource ColumnHeaderText}"/>
                    </Grid>
                </Border>

                <ListView x:Name="JobList" Background="Transparent" BorderThickness="0"
                          ItemsSource="{Binding Jobs}"
                          SelectedItem="{Binding Selected, Mode=TwoWay}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="20,10"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding CreatedAt, Converter={StaticResource LocalTime}}"
                                               FontSize="11" Foreground="{DynamicResource TextSubtleBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding OrderToken, FallbackValue='—'}"
                                           FontSize="13" Foreground="{DynamicResource TextBodyBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" FontSize="13" Foreground="{DynamicResource TextBodyBrush}"
                                           VerticalAlignment="Center">
                                    <Run Text="{Binding PageCount, Mode=OneWay}"/>
                                    <Run Text="{Binding PageRange, Mode=OneWay, FallbackValue=''}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                </TextBlock>
                                <TextBlock Grid.Column="3" Text="{Binding Copies}" FontSize="13"
                                           Foreground="{DynamicResource TextBodyBrush}" VerticalAlignment="Center"/>
                                <Border Grid.Column="4" Style="{StaticResource JobPill}" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource JobPillText}"
                                               Text="{Binding Status}"/>
                                </Border>
                                <TextBlock Grid.Column="5" Text="{Binding LastError, FallbackValue='—'}"
                                           FontSize="12" Foreground="{DynamicResource DangerBrush}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Selection action bar — the operator commands -->
                <Border Background="{DynamicResource SubsurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1"
                        Padding="20,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}">
                            <Run Text="Selected: " />
                            <Run Text="{Binding Selected.Title, Mode=OneWay, FallbackValue='—'}"/>
                        </TextBlock>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Retry" Click="Retry_Click" Style="{StaticResource OperatorButton}"/>
                            <Button Content="Mark resolved" Click="MarkResolved_Click" Style="{StaticResource OperatorButton}"/>
                            <Button Content="Reprint" Click="Reprint_Click" Style="{StaticResource OperatorButton}"/>
                            <Button Content="Cancel job" Click="CancelJob_Click" Style="{StaticResource DangerButton}"
                                    Padding="14,7" FontSize="12" Margin="0,0,8,0" MinHeight="32"/>
                            <Button Content="Clear failed" Click="ClearFailed_Click" Style="{StaticResource DangerButton}"
                                    Padding="14,7" FontSize="12" MinHeight="32"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center" Margin="0,40"
                            Visibility="{Binding Jobs.Count, Converter={StaticResource ZeroToVis}}">
                    <Border Style="{StaticResource EmptyStateGlyph}" Margin="0,0,0,10">
                        <TextBlock Text="&#xE749;" FontFamily="{StaticResource IconFontFamily}" FontSize="18"
                                   Foreground="{DynamicResource BrandDarkBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Queue is empty" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="New print jobs appear here the moment the dashboard dispatches them"
                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
