<UserControl
    x:Class="PrintShopCompanion.App.Views.PrintQueueView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- Job status pill — web semantic colors (soft bg + strong text).
             Uncertain/unknown states get the warning amber: they REQUIRE
             operator reconciliation, so they must stand out. -->
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Pending">
                    <Setter Property="Background" Value="#F3F4F6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Downloading">
                    <Setter Property="Background" Value="#DBF3FF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Rendering">
                    <Setter Property="Background" Value="#DBF3FF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Spooled">
                    <Setter Property="Background" Value="#E1EFFF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Printed">
                    <Setter Property="Background" Value="#E0F5E5"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="ReportedPrinted">
                    <Setter Property="Background" Value="#E0F5E5"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Background" Value="#FFE7E4"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="UncertainSpooled">
                    <Setter Property="Background" Value="#FFE8CC"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="OutcomeUnknown">
                    <Setter Property="Background" Value="#FFE8CC"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter Property="Background" Value="#F3F4F6"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusPillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Downloading">
                    <Setter Property="Foreground" Value="#006E9E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Rendering">
                    <Setter Property="Foreground" Value="#006E9E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Spooled">
                    <Setter Property="Foreground" Value="#2858CD"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Printed">
                    <Setter Property="Foreground" Value="#007F3D"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="ReportedPrinted">
                    <Setter Property="Foreground" Value="#007F3D"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Foreground" Value="#BE222A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="UncertainSpooled">
                    <Setter Property="Foreground" Value="#7A4B0E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="OutcomeUnknown">
                    <Setter Property="Foreground" Value="#7A4B0E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter Property="Foreground" Value="#6B7280"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F7F7F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <DockPanel Margin="24,18,24,18">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Print Queue" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="Local print jobs — refreshes live as jobs dispatch and print"
                               FontSize="12.5" Foreground="#6B7280" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Content="↻  Refresh" Click="Refresh_Click" DockPanel.Dock="Right"
                        HorizontalAlignment="Right" Padding="16,9" FontSize="13"
                        Background="#FFFFFF" Foreground="#374151" BorderBrush="#E5E7EB"
                        BorderThickness="1" Cursor="Hand" FontWeight="Medium"/>
            </DockPanel>
        </Border>

        <!-- Queue content -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="10" BorderBrush="#E5E7EB"
                BorderThickness="1" Margin="24,20">
            <StackPanel>
                <!-- Header row + summary chips -->
                <Border Background="#FAFAFA" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"
                        Padding="20,14">
                    <DockPanel>
                        <TextBlock Text="Queue" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#111827" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Jobs.Count, StringFormat={}{0} jobs}"
                                   FontSize="12" Foreground="#6B7280"
                                   DockPanel.Dock="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Border Background="#F3F4F6" CornerRadius="12" Padding="12,4" Margin="0,0,8,0">
                                <TextBlock FontSize="11" Foreground="#374151">
                                    <Run Text="{Binding PendingCount, Mode=OneWay}"/><Run Text=" pending"/>
                                </TextBlock>
                            </Border>
                            <Border Background="#E1EFFF" CornerRadius="12" Padding="12,4" Margin="0,0,8,0">
                                <TextBlock FontSize="11" Foreground="#2858CD">
                                    <Run Text="{Binding ActiveCount, Mode=OneWay}"/><Run Text=" active"/>
                                </TextBlock>
                            </Border>
                            <Border Background="#E0F5E5" CornerRadius="12" Padding="12,4" Margin="0,0,8,0">
                                <TextBlock FontSize="11" Foreground="#007F3D">
                                    <Run Text="{Binding PrintedCount, Mode=OneWay}"/><Run Text=" printed"/>
                                </TextBlock>
                            </Border>
                            <Border Background="#FFE7E4" CornerRadius="12" Padding="12,4">
                                <TextBlock FontSize="11" Foreground="#BE222A">
                                    <Run Text="{Binding FailedCount, Mode=OneWay}"/><Run Text=" failed"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Table header row -->
                <Border Background="#FFFFFF" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1"
                        Padding="20,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="JOB" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                        <TextBlock Grid.Column="1" Text="TOKEN" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                        <TextBlock Grid.Column="2" Text="PAGES" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                        <TextBlock Grid.Column="3" Text="COPIES" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                        <TextBlock Grid.Column="4" Text="STATUS" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                        <TextBlock Grid.Column="5" Text="LAST ERROR" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                    </Grid>
                </Border>

                <ListView x:Name="JobList" Background="Transparent" BorderThickness="0"
                          ItemsSource="{Binding Jobs}"
                          SelectedItem="{Binding Selected, Mode=TwoWay}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="20,10"/>
                            <Setter Property="BorderBrush" Value="#F3F4F6"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium"
                                               Foreground="#111827" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding CreatedAt, Converter={StaticResource LocalTime}}"
                                               FontSize="11" Foreground="#9CA3AF"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding OrderToken, FallbackValue='—'}"
                                           FontSize="13" Foreground="#374151" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" FontSize="13" Foreground="#374151"
                                           VerticalAlignment="Center">
                                    <Run Text="{Binding PageCount, Mode=OneWay}"/>
                                    <Run Text="{Binding PageRange, Mode=OneWay, FallbackValue=''}" FontSize="11" Foreground="#6B7280"/>
                                </TextBlock>
                                <TextBlock Grid.Column="3" Text="{Binding Copies}" FontSize="13"
                                           Foreground="#374151" VerticalAlignment="Center"/>
                                <Border Grid.Column="4" Style="{StaticResource StatusPill}" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource StatusPillText}"
                                               Text="{Binding Status}"/>
                                </Border>
                                <TextBlock Grid.Column="5" Text="{Binding LastError, FallbackValue='—'}"
                                           FontSize="12" Foreground="#BE222A" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Selection action bar — the operator commands now have UI -->
                <Border Background="#FAFAFA" BorderBrush="#E5E7EB" BorderThickness="0,1"
                        Padding="20,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12"
                                   Foreground="#6B7280">
                            <Run Text="Selected: " />
                            <Run Text="{Binding Selected.Title, Mode=OneWay, FallbackValue='—'}"/>
                        </TextBlock>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Retry" Click="Retry_Click" Padding="14,7" FontSize="12" Cursor="Hand"
                                    Margin="0,0,8,0" Background="#FFFFFF" Foreground="#2858CD"
                                    BorderBrush="#AEBEDF" BorderThickness="1" FontWeight="Medium"/>
                            <Button Content="Mark resolved" Click="MarkResolved_Click" Padding="14,7" FontSize="12" Cursor="Hand"
                                    Margin="0,0,8,0" Background="#FFFFFF" Foreground="#007F3D"
                                    BorderBrush="#A3D8B5" BorderThickness="1" FontWeight="Medium"/>
                            <Button Content="Reprint" Click="Reprint_Click" Padding="14,7" FontSize="12" Cursor="Hand"
                                    Margin="0,0,8,0" Background="#FFFFFF" Foreground="#2858CD"
                                    BorderBrush="#AEBEDF" BorderThickness="1" FontWeight="Medium"/>
                            <Button Content="Cancel job" Click="CancelJob_Click" Padding="14,7" FontSize="12" Cursor="Hand"
                                    Margin="0,0,8,0" Background="#FFFFFF" Foreground="#BE222A"
                                    BorderBrush="#E8A9A5" BorderThickness="1" FontWeight="Medium"/>
                            <Button Content="Clear failed" Click="ClearFailed_Click" Padding="14,7" FontSize="12" Cursor="Hand"
                                    Background="#FFFFFF" Foreground="#BE222A"
                                    BorderBrush="#E8A9A5" BorderThickness="1" FontWeight="Medium"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center" Margin="0,40"
                            Visibility="{Binding Jobs.Count, Converter={StaticResource InverseBoolToVis}}">
                    <Border Width="56" Height="56" CornerRadius="28" Background="#F3F4F6" Margin="0,0,0,12">
                        <TextBlock Text="🖨" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Queue is empty" FontSize="14" FontWeight="Medium"
                               Foreground="#111827" HorizontalAlignment="Center"/>
                    <TextBlock Text="New print jobs appear here the moment the dashboard dispatches them"
                               FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
