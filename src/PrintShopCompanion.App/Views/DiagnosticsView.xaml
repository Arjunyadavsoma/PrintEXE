<UserControl x:Class="PrintShopCompanion.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFontFamily}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <DockPanel Margin="{StaticResource PageMargin}">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Diagnostics" Style="{StaticResource PageTitleText}"/>
                    <TextBlock Text="Health checks for cloud, local store, printers, and disk"
                               Style="{StaticResource PageSubtitleText}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Run check" Command="{Binding RunCheckCommand}" Margin="0,0,8,0"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                    <Button Content="Export" Command="{Binding ExportCommand}"
                            Style="{StaticResource SecondaryButton}"
                            ToolTip="Export a diagnostics report to share with support"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Busy: status line carries the state (no separate spinner row) -->
        <Border Grid.Row="1" Background="{DynamicResource BrandSofterBrush}" Padding="24,10"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFontFamily}" FontSize="13"
                           Foreground="{DynamicResource BrandDarkBrush}" VerticalAlignment="Center" Margin="0,0,8,0"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <RotateTransform x:Name="BusySpin" Angle="0"/>
                    </TextBlock.RenderTransform>
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="BusySpin"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="360" Duration="0:0:1.2"
                                                     RepeatBehavior="Forever"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
                <TextBlock Text="{Binding StatusLine}" VerticalAlignment="Center"
                           Foreground="{DynamicResource BrandDarkBrush}" FontWeight="Medium"/>
            </StackPanel>
        </Border>

        <!-- Facts -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,24">
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Cloud" Style="{StaticResource CardTitleText}" Margin="0,0,0,10"/>
                        <StackPanel>
                            <TextBlock Text="Backend URL" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Text="{Binding BaseUrl}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
                            <TextBlock Text="Reachable" Style="{StaticResource MutedText}" Margin="0,6,0,2"/>
                            <TextBlock Text="{Binding CloudReachable}" Style="{StaticResource BodyText}" Margin="12,0,0,0"/>
                            <TextBlock Text="Token valid" Style="{StaticResource MutedText}" Margin="0,6,0,2"/>
                            <TextBlock Text="{Binding TokenValid}" Style="{StaticResource BodyText}" Margin="12,0,0,0"/>
                            <TextBlock Text="Device registered" Style="{StaticResource MutedText}" Margin="0,6,0,2"/>
                            <TextBlock Text="{Binding DeviceRegistered}" Style="{StaticResource BodyText}" Margin="12,0,0,0"/>
                            <TextBlock Text="Device ID" Style="{StaticResource MutedText}" Margin="0,6,0,2"/>
                            <TextBlock Text="{Binding DeviceId}" Style="{StaticResource MonoText}" FontSize="13" Margin="12,0,0,0"/>
                            <TextBlock Text="Shop ID" Style="{StaticResource MutedText}" Margin="0,6,0,2"/>
                            <TextBlock Text="{Binding ShopId}" Style="{StaticResource MonoText}" FontSize="13" Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Local store" Style="{StaticResource CardTitleText}" Margin="0,0,0,10"/>
                        <StackPanel>
                            <TextBlock Text="Database healthy" Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Text="{Binding DatabaseHealthy}" Style="{StaticResource BodyText}" Margin="12,0,0,0"/>
                            <TextBlock Text="Queue" Style="{StaticResource MutedText}" Margin="0,6,0,2"/>
                            <TextBlock Text="{Binding QueueSummary}" Style="{StaticResource BodyText}" Margin="12,0,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="Queue worker" Style="{StaticResource MutedText}" Margin="0,6,0,2"/>
                            <TextBlock Text="{Binding QueueState}" Style="{StaticResource BodyText}" Margin="12,0,0,0"/>
                            <TextBlock Text="Last successful print" Style="{StaticResource MutedText}" Margin="0,6,0,2"/>
                            <TextBlock Text="{Binding LastPrint}" Style="{StaticResource BodyText}" Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Printers" Style="{StaticResource CardTitleText}" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding PrinterSummary}" Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Disk" Style="{StaticResource CardTitleText}" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding DiskSummary}" Style="{StaticResource BodyText}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Issues" Style="{StaticResource CardTitleText}" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding Errors}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource DangerBrush}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding ExportPath}" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
