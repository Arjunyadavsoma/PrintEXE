<UserControl
    x:Class="PrintShopCompanion.App.Views.SyncCenterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    FontFamily="Segoe UI">

    <Grid Background="#F7F7F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <DockPanel Margin="24,18,24,18">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Sync Center" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="Background synchronization status and pending operations"
                               FontSize="12.5" Foreground="#6B7280" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ManualSyncButton" Content="↻  Sync Now" Click="SyncNow_Click"
                            Padding="16,9" FontSize="13"
                            Background="#D97706" Foreground="White" BorderThickness="0"
                            FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20">

                <!-- CONNECTION STATUS section -->
                <TextBlock Text="CONNECTION STATUS" FontSize="11" FontWeight="SemiBold"
                           Foreground="#9CA3AF" Margin="0,0,0,10"/>
                <Border Background="#FFFFFF" CornerRadius="10" BorderBrush="#E5E7EB"
                        BorderThickness="1" Margin="0,0,0,20">
                    <StackPanel>
                        <DockPanel Margin="20,16">
                            <Border Width="10" Height="10" CornerRadius="5" DockPanel.Dock="Left"
                                    VerticalAlignment="Center" Margin="0,0,14,0"
                                    Background="{Binding ConnectionDotBrush}"/>
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ConnectionStatusText}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#111827"/>
                                <TextBlock Text="{Binding ConnectionSubText}" FontSize="11.5"
                                           Foreground="#6B7280" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Background="{Binding ConnectionPillBrush}" CornerRadius="10" Padding="10,3"
                                    DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ConnectionPillText}" FontSize="11" FontWeight="Medium"
                                           Foreground="{Binding ConnectionPillForeground}"/>
                            </Border>
                        </DockPanel>
                        <Border Height="1" Background="#F3F4F6" Margin="20,0"/>
                        <DockPanel Margin="20,16">
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="Last successful sync" FontSize="11.5" Foreground="#6B7280"/>
                                <TextBlock x:Name="LastSyncLabel" Text="{Binding LastSyncText}" FontSize="14"
                                           FontWeight="Medium" Foreground="#111827" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- PENDING OPERATIONS section -->
                <TextBlock Text="PENDING OPERATIONS" FontSize="11" FontWeight="SemiBold"
                           Foreground="#9CA3AF" Margin="0,0,0,10"/>
                <Border Background="#FFFFFF" CornerRadius="10" BorderBrush="#E5E7EB"
                        BorderThickness="1" Margin="0,0,0,20">
                    <StackPanel>
                        <DockPanel Margin="20,16">
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="Queued operations" FontSize="13.5" FontWeight="Medium"
                                           Foreground="#111827"/>
                                <TextBlock Text="These will be pushed to the backend when connectivity returns"
                                           FontSize="11.5" Foreground="#6B7280" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="PendingCountLabel" Text="{Binding PendingCountText}"
                                       FontSize="22" FontWeight="Bold" Foreground="#D97706"
                                       DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border Height="1" Background="#F3F4F6" Margin="20,0"/>

                        <!-- Pending ops list -->
                        <ListView x:Name="PendingList" Background="Transparent" BorderThickness="0"
                                  ItemsSource="{Binding PendingOps}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="20,12"/>
                                    <Setter Property="BorderBrush" Value="#F3F4F6"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding OperationType}"
                                                   FontSize="13" FontWeight="Medium" Foreground="#111827"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TargetId}"
                                                   FontSize="12" Foreground="#374151"
                                                   FontFamily="Consolas" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="2" Background="#F3F4F6" CornerRadius="10"
                                                Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Medium"
                                                       Foreground="#374151"/>
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="{Binding LastError}"
                                                   FontSize="11.5" Foreground="#9CA3AF" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel HorizontalAlignment="Center" Margin="0,24"
                                    Visibility="{Binding HasNoPending, Converter={StaticResource StringToVis}}">
                            <TextBlock Text="No pending operations" FontSize="13" Foreground="#6B7280"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- FAILED OPERATIONS section -->
                <TextBlock Text="FAILED OPERATIONS" FontSize="11" FontWeight="SemiBold"
                           Foreground="#9CA3AF" Margin="0,0,0,10"/>
                <Border Background="#FFFFFF" CornerRadius="10" BorderBrush="#E5E7EB"
                        BorderThickness="1" Margin="0,0,0,20">
                    <StackPanel>
                        <DockPanel Margin="20,16">
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="Permanently failed operations" FontSize="13.5" FontWeight="Medium"
                                           Foreground="#111827"/>
                                <TextBlock Text="These exceeded the max retry count and will not be retried automatically"
                                           FontSize="11.5" Foreground="#6B7280" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="FailedCountLabel" Text="{Binding FailedCountText}"
                                       FontSize="22" FontWeight="Bold" Foreground="#DC2626"
                                       DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border Height="1" Background="#F3F4F6" Margin="20,0"/>

                        <ListView x:Name="FailedList" Background="Transparent" BorderThickness="0"
                                  ItemsSource="{Binding FailedOps}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="20,12"/>
                                    <Setter Property="BorderBrush" Value="#F3F4F6"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding OperationType}"
                                                   FontSize="13" FontWeight="Medium" Foreground="#111827"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TargetId}"
                                                   FontSize="12" Foreground="#374151"
                                                   FontFamily="Consolas" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding LastError}"
                                                   FontSize="11.5" Foreground="#DC2626" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" Margin="12,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel HorizontalAlignment="Center" Margin="0,24"
                                    Visibility="{Binding HasNoFailed, Converter={StaticResource StringToVis}}">
                            <TextBlock Text="No failed operations" FontSize="13" Foreground="#6B7280"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- DEVICE IDENTITY section -->
                <TextBlock Text="DEVICE IDENTITY" FontSize="11" FontWeight="SemiBold"
                           Foreground="#9CA3AF" Margin="0,0,0,10"/>
                <Border Background="#FFFFFF" CornerRadius="10" BorderBrush="#E5E7EB"
                        BorderThickness="1">
                    <StackPanel>
                        <DockPanel Margin="20,16">
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="Device ID" FontSize="11.5" Foreground="#6B7280"/>
                                <TextBlock x:Name="DeviceIdLabel" Text="{Binding DeviceId}" FontSize="14"
                                           FontFamily="Consolas" Foreground="#111827" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
