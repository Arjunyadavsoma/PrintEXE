<UserControl
    x:Class="PrintShopCompanion.App.Views.OverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">

            <!-- Header -->
            <DockPanel Margin="0,0,0,24">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="{Binding ShopName}" Style="{StaticResource SectionHeading}" />
                    <TextBlock Text="Dashboard overview" Style="{StaticResource BodyText}" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Refresh"
                        Command="{Binding LoadCommand}" HorizontalAlignment="Right" />
            </DockPanel>

            <!-- Error -->
            <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="10"
                    Padding="16,10" Margin="0,0,0,16"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" FontSize="13"
                           Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
            </Border>

            <!-- Stats — WrapPanel for responsive layout -->
            <WrapPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Border Style="{StaticResource StatCard}" Width="200">
                    <StackPanel>
                        <TextBlock Text="Revenue" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding RevenueFormatted}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}" Width="200">
                    <StackPanel>
                        <TextBlock Text="Total Orders" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding TotalOrders}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}" Width="200">
                    <StackPanel>
                        <TextBlock Text="Paid" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding PaidOrders}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}" Width="200">
                    <StackPanel>
                        <TextBlock Text="Printing" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding Printing}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}" Width="200">
                    <StackPanel>
                        <TextBlock Text="Ready" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding Ready}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Recent orders -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="Recent Orders" FontSize="15" FontWeight="SemiBold" DockPanel.Dock="Left" />
                    </DockPanel>

                    <ListView ItemsSource="{Binding RecentOrders}"
                              Background="Transparent" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Token" Width="80"
                                                DisplayMemberBinding="{Binding TokenNumber}" />
                                <GridViewColumn Header="Customer" Width="120"
                                                DisplayMemberBinding="{Binding CustomerPhone}" />
                                <GridViewColumn Header="Status" Width="120"
                                                DisplayMemberBinding="{Binding Status}" />
                                <GridViewColumn Header="Amount" Width="100"
                                                DisplayMemberBinding="{Binding TotalAmountPaise}" />
                                <GridViewColumn Header="Date" Width="120"
                                                DisplayMemberBinding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <TextBlock Text="No orders yet" FontSize="13" Margin="0,20"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Visibility="{Binding RecentOrders.Count, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
