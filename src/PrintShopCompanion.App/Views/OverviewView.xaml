<UserControl
    x:Class="PrintShopCompanion.App.Views.OverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    FontFamily="{StaticResource AppFontFamily}">

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <DockPanel Margin="{StaticResource PageMargin}">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Overview" Style="{StaticResource PageTitleText}"/>
                    <TextBlock Text="Live dashboard mirror — same numbers as the shopkeeper webpage"
                               Style="{StaticResource PageSubtitleText}"/>
                </StackPanel>
                <Button Click="Refresh_Click" DockPanel.Dock="Right"
                        HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}"
                        Content="Refresh" Cursor="Hand"/>
            </DockPanel>
        </Border>

        <!-- Loading state: skeleton keeps the page shape (Operate rule —
             no centered "Loading..." text). -->
        <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="24,20"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,20">
                <StackPanel>
                    <Border Style="{StaticResource SkeletonBar}" Width="220"/>
                    <Border Style="{StaticResource SkeletonBar}" Width="140"/>
                </StackPanel>
            </Border>
            <WrapPanel>
                <Border Style="{StaticResource StatCard}" MinHeight="104"/>
                <Border Style="{StaticResource StatCard}" MinHeight="104"/>
                <Border Style="{StaticResource StatCard}" MinHeight="104"/>
                <Border Style="{StaticResource StatCard}" MinHeight="104" Margin="0"/>
            </WrapPanel>
        </StackPanel>

        <!-- Error state: names the problem and the recovery -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
            <Border Style="{StaticResource EmptyStateGlyph}" Background="{DynamicResource DangerSoftBrush}" Margin="0,0,0,12">
                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFontFamily}" FontSize="20"
                           Foreground="{DynamicResource DangerBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Could not load dashboard" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding ErrorMessage}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16" MaxWidth="360"/>
            <Button Content="Retry" Click="Refresh_Click"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel Margin="24,20,24,24">

                <!-- Shop identity + live pill -->
                <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,24">
                    <DockPanel>
                        <Border Style="{StaticResource Avatar}" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ShopNameInitial}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrandDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ShopName}" Style="{StaticResource CardTitleText}"/>
                            <TextBlock Text="Connected shop" Style="{StaticResource MutedText}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock Text="&#xE703;" FontFamily="{StaticResource IconFontFamily}" FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="{Binding IsLive, Converter={StaticResource BoolToLiveBrush}}"
                                       VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding LiveStatusText}" FontSize="11.5" FontWeight="Medium"
                                       Foreground="{Binding IsLive, Converter={StaticResource BoolToLiveBrush}}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LastSyncText, StringFormat=synced {0}}" FontSize="11"
                                       Foreground="{DynamicResource TextSubtleBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- KPI section heading -->
                <TextBlock Text="Today" Style="{StaticResource SectionHeadingText}"/>

                <!-- Stat cards — full border, tinted label carries the category
                     color (the left accent strip is retired). -->
                <WrapPanel Margin="0,0,0,24">
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="Today's orders" Style="{StaticResource KpiLabel}" Foreground="{DynamicResource BrandDarkBrush}"/>
                            <TextBlock Text="{Binding TodaysOrders}" Style="{StaticResource KpiValue}"/>
                            <TextBlock Text="placed today" Style="{StaticResource KpiSub}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="Today's revenue" Style="{StaticResource KpiLabel}" Foreground="{DynamicResource SuccessBrush}"/>
                            <TextBlock Text="{Binding TodaysRevenueFormatted}" Style="{StaticResource KpiValue}"/>
                            <TextBlock Text="paid today" Style="{StaticResource KpiSub}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="Pending payments" Style="{StaticResource KpiLabel}" Foreground="{DynamicResource WarningBrush}"/>
                            <TextBlock Text="{Binding PendingPayments}" Style="{StaticResource KpiValue}"/>
                            <TextBlock Text="awaiting payment" Style="{StaticResource KpiSub}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="Total orders" Style="{StaticResource KpiLabel}"/>
                            <TextBlock Text="{Binding TotalOrders}" Style="{StaticResource KpiValue}"/>
                            <TextBlock Text="all-time" Style="{StaticResource KpiSub}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="Printing" Style="{StaticResource KpiLabel}" Foreground="{DynamicResource BrandDarkBrush}"/>
                            <TextBlock Text="{Binding Printing}" Style="{StaticResource KpiValue}" Foreground="{DynamicResource BrandDarkBrush}"/>
                            <TextBlock Text="in progress" Style="{StaticResource KpiSub}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="Ready" Style="{StaticResource KpiLabel}" Foreground="{DynamicResource SuccessBrush}"/>
                            <TextBlock Text="{Binding Ready}" Style="{StaticResource KpiValue}" Foreground="{DynamicResource SuccessBrush}"/>
                            <TextBlock Text="ready for pickup" Style="{StaticResource KpiSub}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="All-time revenue" Style="{StaticResource KpiLabel}" Foreground="{DynamicResource InfoBrush}"/>
                            <TextBlock Text="{Binding RevenueFormatted}" Style="{StaticResource KpiValue}"/>
                            <TextBlock Text="since first order" Style="{StaticResource KpiSub}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Recent orders -->
                <TextBlock Text="Recent orders" Style="{StaticResource SectionHeadingText}"/>

                <!-- Recent Orders table card -->
                <Border Style="{StaticResource Card}" Padding="0">
                    <StackPanel>
                        <!-- Table header -->
                        <Border Background="{DynamicResource SubsurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                Padding="20,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Token" Style="{StaticResource ColumnHeaderText}"/>
                                <TextBlock Grid.Column="1" Text="Customer" Style="{StaticResource ColumnHeaderText}"/>
                                <TextBlock Grid.Column="2" Text="Status" Style="{StaticResource ColumnHeaderText}"/>
                                <TextBlock Grid.Column="3" Text="Amount" Style="{StaticResource ColumnHeaderText}"/>
                                <TextBlock Grid.Column="4" Text="Date" Style="{StaticResource ColumnHeaderText}"/>
                            </Grid>
                        </Border>

                        <ListView ItemsSource="{Binding RecentOrders}"
                                  Background="Transparent" BorderThickness="0"
                                  x:Name="RecentOrdersList">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="20,10"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid MouseLeftButtonUp="Row_Click" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding TokenNumber, FallbackValue='—'}"
                                                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CustomerPhone, FallbackValue='—'}"
                                                   FontSize="13" Foreground="{DynamicResource TextBodyBrush}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Style="{StaticResource StatusPill}" HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="{Binding Status, Converter={StaticResource StatusBg}}">
                                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusLabel}}"
                                                       Style="{StaticResource StatusPillText}"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusFg}}"/>
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="{Binding TotalAmountPaise, Converter={StaticResource Rupees}}"
                                                   FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding CreatedAt, Converter={StaticResource LocalTime}}"
                                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Empty state that teaches: what lands here and when -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,28,0,28"
                                    Visibility="{Binding RecentOrders.Count, Converter={StaticResource ZeroToVis}}">
                            <Border Style="{StaticResource EmptyStateGlyph}" Margin="0,0,0,10">
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFontFamily}" FontSize="18"
                                           Foreground="{DynamicResource BrandDarkBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="No orders yet" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                            <TextBlock Text="New orders appear here the moment a customer checks out." 
                                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
