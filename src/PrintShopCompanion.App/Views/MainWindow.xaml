<Window
    x:Class="PrintShopCompanion.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PrintShop"
    Width="1100" Height="700" MinWidth="600" MinHeight="450"
    WindowStartupLocation="CenterScreen"
    Background="White"
    ResizeMode="CanResize">

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarCol" Width="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar (hidden on login) -->
        <Border x:Name="Sidebar" Grid.Column="0" Background="#FAFAFA"
                BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Header -->
                <StackPanel DockPanel.Dock="Top" Margin="20,20,20,16">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#D97706" HorizontalAlignment="Left">
                        <TextBlock Text="P" FontSize="18" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="VersionLabel" Text="v0.4.0" FontSize="10" Foreground="#9CA3AF" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Logout -->
                <Button DockPanel.Dock="Bottom" Content="Sign Out" Click="Logout_Click"
                        HorizontalAlignment="Left" Margin="20,0,0,16" Padding="16,8"
                        Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" FontSize="12"/>

                <!-- Nav items -->
                <StackPanel Margin="12,0">
                    <Button Content="Overview" Click="Nav_Click" Tag="Overview" x:Name="NavOverview"
                            HorizontalContentAlignment="Left" Padding="16,10" Margin="0,2"
                            Background="Transparent" BorderThickness="0" FontSize="14" Cursor="Hand"/>
                    <Button Content="Orders" Click="Nav_Click" Tag="Orders" x:Name="NavOrders"
                            HorizontalContentAlignment="Left" Padding="16,10" Margin="0,2"
                            Background="Transparent" BorderThickness="0" FontSize="14" Cursor="Hand"/>
                    <Button Content="Print Queue" Click="Nav_Click" Tag="PrintQueue" x:Name="NavPrintQueue"
                            HorizontalContentAlignment="Left" Padding="16,10" Margin="0,2"
                            Background="Transparent" BorderThickness="0" FontSize="14" Cursor="Hand"/>
                    <Button Content="Printers" Click="Nav_Click" Tag="Printers" x:Name="NavPrinters"
                            HorizontalContentAlignment="Left" Padding="16,10" Margin="0,2"
                            Background="Transparent" BorderThickness="0" FontSize="14" Cursor="Hand"/>
                    <Button Content="Settings" Click="Nav_Click" Tag="Settings" x:Name="NavSettings"
                            HorizontalContentAlignment="Left" Padding="16,10" Margin="0,2"
                            Background="Transparent" BorderThickness="0" FontSize="14" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Update banner -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="UpdateBanner" Grid.Row="0" Background="#FEF3C7"
                    Padding="16,8" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock x:Name="UpdateText" FontSize="13" FontWeight="Medium"
                               Foreground="#92400E" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    <Button Content="Update Now" Click="Update_Click" DockPanel.Dock="Right"
                            Background="#D97706" Foreground="White" Padding="16,6"
                            BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="1" x:Name="ContentArea"/>
        </Grid>
    </Grid>
</Window>
