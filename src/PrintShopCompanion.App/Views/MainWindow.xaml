<Window
    x:Class="PrintShopCompanion.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PrintShop — Shopkeeper Portal"
    Width="1100" Height="700" MinWidth="900" MinHeight="600"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    WindowStyle="SingleBorderWindow"
    ResizeMode="CanResize">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left navigation rail — matches website layout.tsx -->
        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <!-- Shop header -->
                <StackPanel DockPanel.Dock="Top" Margin="16,16,16,8">
                    <Border Width="36" Height="36" CornerRadius="8"
                            Background="{DynamicResource BrandPrimaryBrush}" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <TextBlock Text="🖨" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrandForegroundBrush}" />
                    </Border>
                    <TextBlock Text="PrintShop" FontSize="14" FontWeight="Bold" />
                    <TextBlock x:Name="VersionLabel" FontSize="10" Opacity="0.5" Margin="0,2,0,0" />
                </StackPanel>

                <!-- User email + logout -->
                <Border DockPanel.Dock="Bottom" Padding="16,12"
                         BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock x:Name="UserEmailLabel" Text="" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="LogoutButton" Content="Sign Out" FontSize="11"
                                Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,6,0,0"
                                Click="LogoutButton_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- Main nav group -->
                <StackPanel Margin="0,0,0,0">
                    <Button Style="{StaticResource NavRailItem}" Content="📊 Overview"
                            Click="Nav_Click" Tag="Overview" x:Name="NavOverview"/>
                    <Button Style="{StaticResource NavRailItem}" Content="📋 Orders"
                            Click="Nav_Click" Tag="Orders" x:Name="NavOrders"/>
                    <Button Style="{StaticResource NavRailItem}" Content="🖨 Print Queue"
                            Click="Nav_Click" Tag="PrintQueue" x:Name="NavPrintQueue"/>
                    <Button Style="{StaticResource NavRailItem}" Content="🖨 Printers"
                            Click="Nav_Click" Tag="Printers" x:Name="NavPrinters"/>
                    <Button Style="{StaticResource NavRailItem}" Content="📈 Reports"
                            Click="Nav_Click" Tag="Reports" x:Name="NavReports"/>
                </StackPanel>

                <!-- Settings group -->
                <TextBlock Text="SETTINGS" FontSize="9" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="16,12,0,4" />
                <StackPanel>
                    <Button Style="{StaticResource NavRailItem}" Content="⚙ Settings"
                            Click="Nav_Click" Tag="Settings" x:Name="NavSettings"/>
                    <Button Style="{StaticResource NavRailItem}" Content="👤 Account"
                            Click="Nav_Click" Tag="Account" x:Name="NavAccount"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Active screen -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Update banner (hidden by default) -->
            <Border x:Name="UpdateBanner" Grid.Row="0"
                    Background="#FEF3C7" BorderBrush="#D97706" BorderThickness="0,0,0,2"
                    Padding="16,8" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="🔄" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="UpdateText" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="UpdateButton" Content="Update Now"
                            Background="#D97706" Foreground="White" Padding="16,6"
                            BorderThickness="0" FontWeight="SemiBold" Click="UpdateButton_Click" />
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" x:Name="ContentArea" />
        </Grid>
    </Grid>
</Window>
