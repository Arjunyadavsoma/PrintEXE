<Window
    x:Class="PrintShopCompanion.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PrintShop Companion"
    Width="1180" Height="740" MinWidth="720" MinHeight="480"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource BackgroundBrush}"
    ResizeMode="CanResize"
    FontFamily="{StaticResource AppFontFamily}">

    <!-- v0.7.15: nav styles now come from Components.xaml (NavRailItem /
         NavRailItemActive) with the full state matrix; the local duplicates
         are gone. -->

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarCol" Width="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar (hidden on login) -->
        <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Brand header -->
                <StackPanel DockPanel.Dock="Top" Margin="20,20,20,20">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource BrandBrush}">
                            <TextBlock Text="P" FontSize="18" FontWeight="SemiBold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PrintShop" FontSize="14.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="VersionLabel" Text="v0.4.3" FontSize="11"
                                       Foreground="{DynamicResource TextSubtleBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Section divider -->
                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="16,0"/>

                <!-- Nav items — main section -->
                <StackPanel DockPanel.Dock="Top" Margin="12,12">
                    <TextBlock Text="Menu" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSubtleBrush}" Margin="12,0,0,8"/>
                    <Button Content="Overview"  Click="Nav_Click" Tag="Overview"  x:Name="NavOverview"  Style="{StaticResource NavRailItem}"/>
                    <Button Content="Orders"     Click="Nav_Click" Tag="Orders"    x:Name="NavOrders"   Style="{StaticResource NavRailItem}"/>
                    <Button Content="Print Queue" Click="Nav_Click" Tag="PrintQueue" x:Name="NavPrintQueue" Style="{StaticResource NavRailItem}"/>
                    <Button Content="Printers"   Click="Nav_Click" Tag="Printers"  x:Name="NavPrinters"  Style="{StaticResource NavRailItem}"/>
                    <Button Content="Sync Center" Click="Nav_Click" Tag="SyncCenter" x:Name="NavSyncCenter" Style="{StaticResource NavRailItem}"/>
                    <Button Content="Diagnostics" Click="Nav_Click" Tag="Diagnostics" x:Name="NavDiagnostics" Style="{StaticResource NavRailItem}"/>
                </StackPanel>

                <!-- Section divider -->
                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="16,8"/>

                <!-- Nav items — system section -->
                <StackPanel DockPanel.Dock="Top" Margin="12,4">
                    <TextBlock Text="System" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSubtleBrush}" Margin="12,0,0,8"/>
                    <Button Content="Settings" Click="Nav_Click" Tag="Settings" x:Name="NavSettings" Style="{StaticResource NavRailItem}"/>
                </StackPanel>

                <!-- Bottom: account + sign out -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource SubsurfaceBrush}" Padding="16,12">
                    <DockPanel>
                        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource BorderBrush}" DockPanel.Dock="Left">
                            <TextBlock x:Name="UserInitial" Text="S" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBodyBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="UserLabel" Text="Shopkeeper" FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="UserSubtitle" Text="Not signed in" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <Button Content="Sign out" Click="Logout_Click" DockPanel.Dock="Right"
                                Style="{StaticResource GhostButton}"
                                VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Update banner -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="UpdateBanner" Grid.Row="0" Background="{DynamicResource WarningSoftBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="20,12" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateStateIcon" Text="&#xE895;" FontFamily="{StaticResource IconFontFamily}" FontSize="13"
                                   Foreground="{DynamicResource BrandDarkBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="UpdateText" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource BrandDarkBrush}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="UpdateProgressText" FontSize="12" Foreground="{DynamicResource BrandDarkBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"/>
                        <ProgressBar x:Name="UpdateProgress" Width="120" Height="6"
                                     VerticalAlignment="Center" Margin="0,0,12,0"
                                     Visibility="Collapsed" Maximum="100"/>
                        <Button x:Name="UpdateButton" Content="Update now" Click="Update_Click"
                                Style="{StaticResource PrimaryButton}" Padding="20,8" FontSize="13"/>
                        <Button x:Name="UpdateDismissButton" Content="Dismiss" Click="UpdateDismiss_Click"
                                Style="{StaticResource GhostButton}"
                                ToolTip="Hide this banner until the next update check"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="1" x:Name="ContentArea"/>
        </Grid>
    </Grid>
</Window>
