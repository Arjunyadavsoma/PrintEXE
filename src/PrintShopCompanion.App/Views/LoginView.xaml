<UserControl
    x:Class="PrintShopCompanion.App.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008">

    <Grid Background="#FEF3C7">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400" Margin="24">

            <!-- Logo -->
            <Border Width="48" Height="48" CornerRadius="12" Background="#D97706"
                    HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="P" FontSize="24" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="Shopkeeper Portal" FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
            <TextBlock Text="Sign in to your print shop account" FontSize="14"
                       Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,0,0,28"/>

            <!-- Card -->
            <Border Background="White" CornerRadius="10" Padding="28" Margin="0,0,0,16">
                <Border.BorderBrush><SolidColorBrush Color="#E5E7EB"/></Border.BorderBrush>
                <Border.BorderThickness>1</Border.BorderThickness>

                <StackPanel>
                    <TextBlock Text="Sign In" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Enter your shop credentials" FontSize="12" Foreground="#6B7280" Margin="0,0,0,20"/>

                    <TextBlock Text="Email" FontSize="12" FontWeight="Medium" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10,8" FontSize="14" Margin="0,0,0,16" BorderBrush="#D1D5DB"/>

                    <TextBlock Text="Password" FontSize="12" FontWeight="Medium" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PasswordBox" Padding="10,8" FontSize="14"
                                 BorderBrush="#D1D5DB" Margin="0,0,0,16"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>

                    <Border Background="#FEF2F2" CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="13" Foreground="#DC2626" TextWrapping="Wrap"/>
                    </Border>

                    <Button Content="Sign In" Click="SignIn_Click"
                            Background="#D97706" Foreground="White" Padding="0,10"
                            FontSize="14" FontWeight="SemiBold" BorderThickness="0"
                            Cursor="Hand" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="#6B7280">
                Don't have a shop account? <Run Text="Register" FontWeight="Medium" Foreground="#D97706"/>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
