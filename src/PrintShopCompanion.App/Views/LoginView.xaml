<UserControl
    x:Class="PrintShopCompanion.App.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    FontFamily="{StaticResource AppFontFamily}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- v0.7.15: form label — visible weight, normal case (was ALL-CAPS
             micro). Field labels name the field plainly. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <!-- Info/error callouts share one shape -->
        <Style x:Key="Callout" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="380"/>
            <ColumnDefinition Width="*" MinWidth="380"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: brand panel -->
        <Border Grid.Column="0" Background="{DynamicResource BrandBrush}">
            <Grid>
                <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Border.Background>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="{StaticResource BrandAccentColor}"/>
                            <GradientStop Offset="1" Color="{StaticResource BrandColor}"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel VerticalAlignment="Center" Margin="48,40">
                    <Border Width="56" Height="56" CornerRadius="14" Background="#FFFFFF" Opacity="0.95"
                            HorizontalAlignment="Left" Margin="0,0,0,28">
                        <TextBlock Text="P" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource BrandBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="PrintShop" FontSize="32" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                    <TextBlock Text="Companion" FontSize="32" FontWeight="SemiBold" Foreground="White" Opacity="0.85" Margin="0,0,0,24"/>

                    <TextBlock Text="The desktop companion that connects your shop printer to the cloud."
                               FontSize="14" Foreground="White" Opacity="0.92"
                               TextWrapping="Wrap" Margin="0,0,0,32" MaxWidth="380"/>

                    <StackPanel Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="22" Height="22" CornerRadius="11" Background="#FFFFFF" Opacity="0.25">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFontFamily}"
                                           Foreground="White" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Auto-print incoming orders" FontSize="13" Foreground="White" Opacity="0.92"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="22" Height="22" CornerRadius="11" Background="#FFFFFF" Opacity="0.25">
                                <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFontFamily}"
                                           Foreground="White" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Offline queue with auto-retry" FontSize="13" Foreground="White" Opacity="0.92"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="22" Height="22" CornerRadius="11" Background="#FFFFFF" Opacity="0.25">
                                <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFontFamily}"
                                           Foreground="White" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Auto-update on every release" FontSize="13" Foreground="White" Opacity="0.92"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="#FFFFFF" Opacity="0.25" Margin="0,28,0,12"/>
                    <TextBlock x:Name="VersionLabel" Text="v0.4.3" FontSize="11" Foreground="White" Opacity="0.85"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- RIGHT: login form -->
        <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                MaxWidth="420" Margin="40">

                    <!-- Auto-sign-in status (login-first UX) -->
                    <Border Padding="12,10"
                            Visibility="{Binding ShowAutoSignIn, Converter={StaticResource BoolToVis}}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Callout}">
                                <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AutoSignInIsError}" Value="False">
                                        <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource InfoBorderBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding AutoSignInMessage}" FontSize="13" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AutoSignInIsError}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- PRIMARY: shopkeeper email + password (live-verified flow) -->
                    <TextBlock Text="Sign in" FontSize="26" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="Use your print shop account — the same email and password as the web dashboard."
                               Style="{StaticResource BodyText}" Margin="0,0,0,24"/>

                    <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputField}"
                             FontSize="14" Margin="0,0,0,18"/>

                    <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,18">
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource InputField}" FontSize="14"
                                     PasswordChanged="PasswordBox_PasswordChanged"/>
                        <TextBox x:Name="PasswordRevealBox" Style="{StaticResource InputField}" FontSize="14"
                                 Visibility="Collapsed"
                                 IsReadOnly="True"
                                 TextChanged="PasswordRevealBox_TextChanged"/>
                        <Button x:Name="TogglePasswordBtn" Content="Show"
                                Click="TogglePassword_Click" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0"/>
                    </Grid>

                    <!-- Error message (sign-in + paste-token flows share it) -->
                    <Border Background="{DynamicResource DangerSoftBrush}" Style="{StaticResource Callout}"
                            BorderBrush="{DynamicResource DangerBorderBrush}"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFontFamily}" FontSize="13"
                                       Foreground="{DynamicResource DangerBrush}" Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ErrorMessage}" FontSize="13" Foreground="{DynamicResource DangerBrush}"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Sign in" Click="SignIn_Click"
                            Style="{StaticResource PrimaryButton}"
                            Padding="0,14" FontSize="14"
                            Margin="0,0,0,16"/>

                    <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSubtleBrush}" TextWrapping="Wrap">
                        Don't have a shop account?
                        <Run Text="Register on the web dashboard" FontWeight="SemiBold" Foreground="{DynamicResource BrandBrush}"/>
                    </TextBlock>

                    <!-- Divider -->
                    <Grid Margin="0,28,0,20">
                        <Border Height="1" Background="{DynamicResource BorderBrush}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource SurfaceBrush}" Padding="10,0" HorizontalAlignment="Center">
                            <TextBlock Text="or connect this computer" FontSize="10.5"
                                       Foreground="{DynamicResource TextSubtleBrush}" FontWeight="Medium"/>
                        </Border>
                    </Grid>

                    <!-- Secondary options: both flows live-verified -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PairingToggle" Click="TogglePairingPanel_Click"
                                Style="{StaticResource SecondaryButton}"
                                Padding="0,10" FontSize="12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8EC;" FontFamily="{StaticResource IconFontFamily}" FontSize="14"
                                           Foreground="{DynamicResource BrandDarkBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Pairing code" FontSize="12" Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="TokenToggle" Grid.Column="2" Click="ToggleTokenPanel_Click"
                                Style="{StaticResource SecondaryButton}"
                                Padding="0,10" FontSize="12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE192;" FontFamily="{StaticResource IconFontFamily}" FontSize="14"
                                           Foreground="{DynamicResource BrandDarkBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Device token" FontSize="12" Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Collapsible: pairing-ticket panel (v1 contract §2) -->
                    <StackPanel x:Name="PairingPanel" Visibility="Collapsed" Margin="0,18,0,0">
                        <TextBlock Text="Pair this computer with a 5-minute pairing code from the web dashboard (Devices → Add Computer)."
                                   Style="{StaticResource MutedText}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                        <!-- Steps explainer -->
                        <Border Background="{DynamicResource InfoSoftBrush}" Style="{StaticResource Callout}"
                                BorderBrush="{DynamicResource InfoBorderBrush}">
                            <StackPanel>
                                <TextBlock Text="How to pair with a 5-minute code" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource InfoBrush}" Margin="0,0,0,6"/>
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="18">
                                    <Run Text="1." FontWeight="SemiBold"/>
                                    <Run Text=" Sign in to your shop on the web dashboard"/><LineBreak/>
                                    <Run Text="2." FontWeight="SemiBold"/>
                                    <Run Text=" Go to Shop → Devices → Add Computer"/><LineBreak/>
                                    <Run Text="3." FontWeight="SemiBold"/>
                                    <Run Text=" Copy the 64-character pairing code (or scan the QR)"/><LineBreak/>
                                    <Run Text="4." FontWeight="SemiBold"/>
                                    <Run Text=" Paste it below, name this PC, click Pair"/><LineBreak/>
                                    <Run Text="   " FontWeight="SemiBold"/>
                                    <Run Text=" The code expires in 5 minutes and works once" Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Pairing code" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding PairingTicket, UpdateSourceTrigger=PropertyChanged}"
                                 x:Name="PairingTicketBox"
                                 Style="{StaticResource InputField}"
                                 FontSize="13" FontFamily="{StaticResource MonoFontFamily}"
                                 Margin="0,0,0,18"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="60"
                                 MaxLength="64"
                                 ToolTip="Paste the 64-hex-character pairing code from the web dashboard"/>

                        <TextBlock Text="Computer name" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}"
                                 x:Name="DeviceNameBox"
                                 Style="{StaticResource InputField}"
                                 FontSize="13"
                                 Margin="0,0,0,18"
                                 MaxLength="120"
                                 ToolTip="A display name for this computer (shown on the website's device list)"/>

                        <!-- Ticket-pairing error message -->
                        <Border Background="{DynamicResource DangerSoftBrush}" Style="{StaticResource Callout}"
                                BorderBrush="{DynamicResource DangerBorderBrush}"
                                Visibility="{Binding TicketErrorMessage, Converter={StaticResource StringToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFontFamily}" FontSize="13"
                                           Foreground="{DynamicResource DangerBrush}" Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TicketErrorMessage}" FontSize="13" Foreground="{DynamicResource DangerBrush}"
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Paired success banner (shown transiently before navigation) -->
                        <Border Background="{DynamicResource SuccessSoftBrush}" Style="{StaticResource Callout}"
                                BorderBrush="{DynamicResource SuccessBorderBrush}"
                                Visibility="{Binding PairedShopName, Converter={StaticResource StringToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFontFamily}" FontSize="13"
                                           Foreground="{DynamicResource SuccessBrush}" Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock FontSize="13" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" TextWrapping="Wrap">
                                    <Run Text="Paired with "/><Run Text="{Binding PairedShopName}" FontWeight="SemiBold"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Button x:Name="PairWithTicketButton" Content="Pair this computer"
                                Click="PairWithTicket_Click"
                                Style="{StaticResource PrimaryButton}"
                                Padding="0,12" FontSize="13"
                                Margin="0,0,0,12"
                                IsEnabled="{Binding IsPairingWithTicket, Converter={StaticResource InverseBool}}"/>

                        <TextBlock Text="Pairing — validating with the server..."
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                                   Margin="0,0,0,4"
                                   Visibility="{Binding IsPairingWithTicket, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <!-- Collapsible: paste-token panel -->
                    <StackPanel x:Name="TokenPanel" Visibility="Collapsed" Margin="0,18,0,0">
                        <TextBlock Text="Paste the device token from the web dashboard's Printer Setup page."
                                   Style="{StaticResource MutedText}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                        <TextBlock Text="Device token" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding DeviceToken, UpdateSourceTrigger=PropertyChanged}"
                                 x:Name="DeviceTokenBox"
                                 Style="{StaticResource InputField}"
                                 FontSize="13"
                                 Margin="0,0,0,18"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="80"
                                 ToolTip="Paste the device token from the web dashboard"/>

                        <Button x:Name="ConnectButton" Content="Connect this PC"
                                Click="PairWithToken_Click"
                                Style="{StaticResource PrimaryButton}"
                                Padding="0,12" FontSize="13"
                                Margin="0,0,0,4"
                                IsEnabled="{Binding IsPairing, Converter={StaticResource InverseBool}}"/>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>

                <TextBlock x:Name="BuildStamp" Text="PrintShop Companion"
                           FontSize="11" Foreground="{DynamicResource TextSubtleBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
