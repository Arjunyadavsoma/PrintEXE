<UserControl
    x:Class="PrintShopCompanion.App.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    FontFamily="Segoe UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="380"/>
            <ColumnDefinition Width="*" MinWidth="380"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: brand panel -->
        <Border Grid.Column="0" Background="#2858CD">
            <Grid>
                <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Border.Background>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#1A48BC"/>
                            <GradientStop Offset="1" Color="#2858CD"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel VerticalAlignment="Center" Margin="48,40">
                    <Border Width="56" Height="56" CornerRadius="14" Background="#FFFFFF" Opacity="0.95"
                            HorizontalAlignment="Left" Margin="0,0,0,28">
                        <TextBlock Text="P" FontSize="28" FontWeight="Bold" Foreground="#2858CD"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="PrintShop" FontSize="32" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                    <TextBlock Text="Companion" FontSize="32" FontWeight="Bold" Foreground="White" Opacity="0.85" Margin="0,0,0,24"/>

                    <TextBlock Text="The desktop companion that connects your shop printer to the cloud."
                               FontSize="14" Foreground="White" Opacity="0.92"
                               TextWrapping="Wrap" Margin="0,0,0,32" MaxWidth="380"/>

                    <StackPanel Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="22" Height="22" CornerRadius="11" Background="#FFFFFF" Opacity="0.25">
                                <TextBlock Text="✓" Foreground="White" FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Auto-print incoming orders" FontSize="13" Foreground="White" Opacity="0.92"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="22" Height="22" CornerRadius="11" Background="#FFFFFF" Opacity="0.25">
                                <TextBlock Text="✓" Foreground="White" FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Offline queue with auto-retry" FontSize="13" Foreground="White" Opacity="0.92"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="22" Height="22" CornerRadius="11" Background="#FFFFFF" Opacity="0.25">
                                <TextBlock Text="✓" Foreground="White" FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Auto-update on every release" FontSize="13" Foreground="White" Opacity="0.92"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="#FFFFFF" Opacity="0.25" Margin="0,28,0,12"/>
                    <TextBlock x:Name="VersionLabel" Text="v0.4.3" FontSize="11" Foreground="White" Opacity="0.85"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- RIGHT: login form -->
        <Border Grid.Column="1" Background="#FFFFFF">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                MaxWidth="420" Margin="40">

                    <!-- Auto-sign-in status (login-first UX): shown while the
                         startup credential restore runs, or when it failed with
                         the reason. Blue while in progress, red on failure. -->
                    <Border Padding="12,10" Margin="0,0,0,18" CornerRadius="8" BorderThickness="1"
                            Visibility="{Binding ShowAutoSignIn, Converter={StaticResource BoolToVis}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FEF2F2"/>
                                <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AutoSignInIsError}" Value="False">
                                        <Setter Property="Background" Value="#EFF6FF"/>
                                        <Setter Property="BorderBrush" Value="#BFDBFE"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding AutoSignInMessage}" FontSize="13" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#991B1B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AutoSignInIsError}" Value="False">
                                            <Setter Property="Foreground" Value="#1E40AF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- ============================== -->
                    <!-- RECOMMENDED (Phase 3): pairing-ticket pairing (v1 contract §2) -->
                    <!-- ============================== -->
                    <TextBlock Text="Pair this computer" FontSize="26" FontWeight="Bold"
                               Foreground="#111827" Margin="0,0,0,6"/>
                    <TextBlock Text="Get a pairing code from your shop's web dashboard (Devices → Add Computer)."
                               FontSize="13" Foreground="#6B7280" Margin="0,0,0,24"/>

                    <!-- Steps explainer -->
                    <Border Background="#EFF6FF" CornerRadius="8" Padding="14,12" Margin="0,0,0,20"
                            BorderBrush="#BFDBFE" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="HOW TO PAIR (5-MINUTE CODE)" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#1E40AF" Margin="0,0,0,6"/>
                            <TextBlock FontSize="11.5" Foreground="#1E3A8A" TextWrapping="Wrap" LineHeight="18">
                                <Run Text="1." FontWeight="Bold"/>
                                <Run Text=" Sign in to your shop on the web dashboard"/><LineBreak/>
                                <Run Text="2." FontWeight="Bold"/>
                                <Run Text=" Go to Shop → Devices → Add Computer"/><LineBreak/>
                                <Run Text="3." FontWeight="Bold"/>
                                <Run Text=" Copy the 64-character pairing code (or scan the QR)"/><LineBreak/>
                                <Run Text="4." FontWeight="Bold"/>
                                <Run Text=" Paste it below, name this PC, click Pair"/><LineBreak/>
                                <Run Text="   " FontWeight="Bold"/>
                                <Run Text=" The code expires in 5 minutes and works once" Foreground="#6B7280" FontStyle="Italic"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="PAIRING CODE" FontSize="11" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding PairingTicket, UpdateSourceTrigger=PropertyChanged}"
                             x:Name="PairingTicketBox"
                             Padding="14,12" FontSize="13" FontFamily="Consolas"
                             Margin="0,0,0,18"
                             BorderBrush="#D1D5DB" BorderThickness="1"
                             VerticalContentAlignment="Center"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="60"
                             MaxLength="64"
                             ToolTip="Paste the 64-hex-character pairing code from the web dashboard"/>

                    <TextBlock Text="COMPUTER NAME" FontSize="11" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}"
                             x:Name="DeviceNameBox"
                             Padding="14,12" FontSize="13"
                             Margin="0,0,0,18"
                             BorderBrush="#D1D5DB" BorderThickness="1"
                             VerticalContentAlignment="Center"
                             MaxLength="120"
                             ToolTip="A display name for this computer (shown on the website's device list)"/>

                    <!-- Ticket-pairing error message -->
                    <Border Background="#FEF2F2" CornerRadius="8" Padding="14,10" Margin="0,0,0,18"
                            BorderBrush="#FECACA" BorderThickness="1"
                            Visibility="{Binding TicketErrorMessage, Converter={StaticResource StringToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠" FontSize="14" Foreground="#BE222A" Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TicketErrorMessage}" FontSize="13" Foreground="#BE222A"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Paired success banner (shown transiently before navigation) -->
                    <Border Background="#ECFDF5" CornerRadius="8" Padding="14,10" Margin="0,0,0,18"
                            BorderBrush="#A7F3D0" BorderThickness="1"
                            Visibility="{Binding PairedShopName, Converter={StaticResource StringToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" FontSize="14" Foreground="#007F3D" Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock FontSize="13" Foreground="#007F3D" VerticalAlignment="Center" TextWrapping="Wrap">
                                <Run Text="Paired with "/><Run Text="{Binding PairedShopName}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Pair button (ticket flow) -->
                    <Button x:Name="PairWithTicketButton" Content="Pair this computer"
                            Click="PairWithTicket_Click"
                            Background="#2858CD" Foreground="White" Padding="0,14"
                            FontSize="14" FontWeight="SemiBold" BorderThickness="0"
                            Cursor="Hand" Margin="0,0,0,12"
                            IsEnabled="{Binding IsPairingWithTicket, Converter={StaticResource InverseBool}}"/>

                    <!-- Loading indicator (ticket flow) -->
                    <TextBlock Text="Pairing — validating with the server..."
                               FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center"
                               Margin="0,0,0,24"
                               Visibility="{Binding IsPairingWithTicket, Converter={StaticResource BoolToVis}}"/>

                    <!-- Divider -->
                    <Grid Margin="0,0,0,24">
                        <Border Height="1" Background="#E5E7EB" VerticalAlignment="Center"/>
                        <Border Background="#FFFFFF" Padding="10,0" HorizontalAlignment="Center">
                            <TextBlock Text="OR — LEGACY PASTE-TOKEN / SHOPKEEPER LOGIN" FontSize="10"
                                       Foreground="#9CA3AF" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <!-- ============================== -->
                    <!-- LEGACY: paste-token pairing -->
                    <!-- ============================== -->
                    <TextBlock Text="Connect with a device token (legacy)" FontSize="16" FontWeight="Bold"
                               Foreground="#111827" Margin="0,0,0,6"/>
                    <TextBlock Text="Paste the device token from the web dashboard's Printer Setup page."
                               FontSize="13" Foreground="#6B7280" Margin="0,0,0,24"/>

                    <TextBlock Text="DEVICE TOKEN" FontSize="11" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding DeviceToken, UpdateSourceTrigger=PropertyChanged}"
                             x:Name="DeviceTokenBox"
                             Padding="14,12" FontSize="13"
                             Margin="0,0,0,18"
                             BorderBrush="#D1D5DB" BorderThickness="1"
                             VerticalContentAlignment="Center"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="80"
                             ToolTip="Paste the device token from the web dashboard"/>

                    <!-- Error message (shared by both legacy flows) -->
                    <Border Background="#FEF2F2" CornerRadius="8" Padding="14,10" Margin="0,0,0,18"
                            BorderBrush="#FECACA" BorderThickness="1"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠" FontSize="14" Foreground="#BE222A" Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ErrorMessage}" FontSize="13" Foreground="#BE222A"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Connect button (paste-token flow) -->
                    <Button x:Name="ConnectButton" Content="Connect this PC (paste token)"
                            Click="PairWithToken_Click"
                            Background="#6B7280" Foreground="White" Padding="0,14"
                            FontSize="14" FontWeight="SemiBold" BorderThickness="0"
                            Cursor="Hand" Margin="0,0,0,24"
                            IsEnabled="{Binding IsPairing, Converter={StaticResource InverseBool}}"/>

                    <!-- Divider -->
                    <Grid Margin="0,0,0,24">
                        <Border Height="1" Background="#E5E7EB" VerticalAlignment="Center"/>
                        <Border Background="#FFFFFF" Padding="10,0" HorizontalAlignment="Center">
                            <TextBlock Text="OR — LEGACY SHOPKEEPER LOGIN" FontSize="10"
                                       Foreground="#9CA3AF" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <!-- ============================== -->
                    <!-- LEGACY: shopkeeper email+password -->
                    <!-- ============================== -->
                    <TextBlock Text="EMAIL" FontSize="11" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Padding="14,12" FontSize="14" Margin="0,0,0,18"
                             BorderBrush="#D1D5DB" BorderThickness="1"
                             VerticalContentAlignment="Center"/>

                    <TextBlock Text="PASSWORD" FontSize="11" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,18">
                        <PasswordBox x:Name="PasswordBox" Padding="14,12" FontSize="14"
                                     BorderBrush="#D1D5DB" BorderThickness="1"
                                     PasswordChanged="PasswordBox_PasswordChanged"
                                     VerticalContentAlignment="Center"/>
                        <TextBox x:Name="PasswordRevealBox" Padding="14,12" FontSize="14"
                                 BorderBrush="#D1D5DB" BorderThickness="1"
                                 Visibility="Collapsed"
                                 IsReadOnly="True"
                                 VerticalContentAlignment="Center"
                                 TextChanged="PasswordRevealBox_TextChanged"/>
                        <Button x:Name="TogglePasswordBtn" Content="Show"
                                Click="TogglePassword_Click"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#6B7280" FontSize="11" Cursor="Hand"
                                Padding="14,0" Margin="0,0,4,0"/>
                    </Grid>

                    <Button Content="Sign In (legacy)" Click="SignIn_Click"
                            Background="#374151" Foreground="White" Padding="0,12"
                            FontSize="13" FontWeight="SemiBold" BorderThickness="0"
                            Cursor="Hand" Margin="0,0,0,16"/>

                    <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap">
                        Don't have a shop account?
                        <Run Text="Register on the web dashboard" FontWeight="SemiBold" Foreground="#2858CD"/>
                    </TextBlock>
                </StackPanel>
                </ScrollViewer>

                <TextBlock x:Name="BuildStamp" Text="PrintShop Companion"
                           FontSize="11" Foreground="#9CA3AF"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

