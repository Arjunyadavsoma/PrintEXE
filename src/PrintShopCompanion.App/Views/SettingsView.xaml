<UserControl
    x:Class="PrintShopCompanion.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    FontFamily="{StaticResource AppFontFamily}">

    <UserControl.Resources>
        <!-- Settings row: label + description on the left, control right.
             One vocabulary for every row (Operate: consistent affordances). -->
        <Style x:Key="SettingsRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="20,16"/>
        </Style>
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BorderSoftBrush}"/>
            <Setter Property="Margin" Value="20,0"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="RowDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource BackgroundBrush}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24">

            <!-- Page header -->
            <TextBlock Text="Settings" Style="{StaticResource PageTitleText}" Margin="0,0,0,4"/>
            <TextBlock Text="Configure your companion app and account"
                       Style="{StaticResource PageSubtitleText}" Margin="0,0,0,24"/>

            <!-- ===== Application section ===== -->
            <TextBlock Text="Application" Style="{StaticResource SectionHeadingText}"/>
            <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <!-- Row 1: Launch at startup -->
                    <DockPanel Style="{StaticResource SettingsRow}">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="Launch at Windows startup" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Open the companion when you sign in to Windows"
                                       Style="{StaticResource RowDescription}"/>
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Style="{StaticResource RowDivider}"/>

                    <!-- Row 2: Minimize to tray -->
                    <DockPanel Style="{StaticResource SettingsRow}">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="Minimize to tray on close" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Keep the companion running in the system tray"
                                       Style="{StaticResource RowDescription}"/>
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Style="{StaticResource RowDivider}"/>

                    <!-- Row 3: Follow system theme -->
                    <DockPanel Style="{StaticResource SettingsRow}">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="Follow system theme" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Match Windows light/dark mode automatically"
                                       Style="{StaticResource RowDescription}"/>
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ===== Shop information section ===== -->
            <TextBlock Text="Shop information" Style="{StaticResource SectionHeadingText}"/>
            <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <DockPanel Style="{StaticResource SettingsRow}">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="Connected shop" Style="{StaticResource MutedText}"/>
                            <TextBlock x:Name="ShopNameLabel" Text="Not connected" FontSize="14"
                                       FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Style="{StaticResource StatusPill}" Background="{DynamicResource SuccessSoftBrush}"
                                DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Connected" Style="{StaticResource StatusPillText}"
                                       Foreground="{DynamicResource SuccessBrush}"/>
                        </Border>
                    </DockPanel>
                    <Border Style="{StaticResource RowDivider}"/>

                    <DockPanel Style="{StaticResource SettingsRow}">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="Device ID" Style="{StaticResource MutedText}"/>
                            <TextBlock x:Name="DeviceIdLabel" Text="—" FontSize="14"
                                       FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource RowDivider}"/>

                    <DockPanel Style="{StaticResource SettingsRow}">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="App version" Style="{StaticResource MutedText}"/>
                            <TextBlock x:Name="VersionLabel" Text="v0.4.3" FontSize="14"
                                       FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ===== Diagnostics section ===== -->
            <TextBlock Text="Diagnostics" Style="{StaticResource SectionHeadingText}"/>
            <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <DockPanel Style="{StaticResource SettingsRow}">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="Open log folder" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Open the folder where daily logs are stored"
                                       Style="{StaticResource RowDescription}"/>
                        </StackPanel>
                        <Button Content="Open" Click="OpenLogs_Click" DockPanel.Dock="Right"
                                HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ===== Account section ===== -->
            <TextBlock Text="Account" Style="{StaticResource SectionHeadingText}"/>
            <Border Style="{StaticResource Card}" Padding="0">
                <DockPanel Style="{StaticResource SettingsRow}">
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="Sign out of this device" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="You'll need to sign in again to receive print jobs"
                                   Style="{StaticResource RowDescription}"/>
                    </StackPanel>
                    <Button Content="Sign out" Click="SignOut_Click" DockPanel.Dock="Right"
                            HorizontalAlignment="Right" Style="{StaticResource DangerButton}"/>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
