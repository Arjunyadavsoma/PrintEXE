<UserControl
    x:Class="PrintShopCompanion.App.Views.OrdersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="24,24,24,0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Orders" FontSize="22" FontWeight="Bold" Foreground="#1F2937"/>
                <TextBlock Text="Manage customer print orders" FontSize="13" Foreground="#6B7280" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Content="Refresh" Click="Refresh_Click" DockPanel.Dock="Right"
                    HorizontalAlignment="Right" Padding="16,8" FontSize="13"
                    Background="#F3F4F6" Foreground="#374151" BorderBrush="#E5E7EB"
                    BorderThickness="1" Cursor="Hand"/>
        </DockPanel>

        <!-- Loading -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Loading orders..." FontSize="14" Foreground="#6B7280"/>
        </StackPanel>

        <!-- Error -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorMessage}" FontSize="14" Foreground="#DC2626"
                       TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>

        <!-- Orders table -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#E5E7EB"
                BorderThickness="1" Margin="24" Padding="20"
                Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel>
                <TextBlock Text="Order Queue" FontSize="15" FontWeight="SemiBold"
                           Foreground="#1F2937" Margin="0,0,0,12"/>
                <ListView ItemsSource="{Binding Orders}" Background="Transparent" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Token" Width="80" DisplayMemberBinding="{Binding TokenNumber}"/>
                            <GridViewColumn Header="Customer" Width="120" DisplayMemberBinding="{Binding CustomerPhone}"/>
                            <GridViewColumn Header="Status" Width="100" DisplayMemberBinding="{Binding Status}"/>
                            <GridViewColumn Header="Amount" Width="100" DisplayMemberBinding="{Binding TotalAmountPaise}"/>
                            <GridViewColumn Header="Date" Width="120" DisplayMemberBinding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock Text="No orders found" FontSize="13" Foreground="#6B7280"
                           HorizontalAlignment="Center" Margin="0,20"
                           Visibility="{Binding Orders.Count, Converter={StaticResource InverseBoolToVis}}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
