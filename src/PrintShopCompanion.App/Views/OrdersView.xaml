<UserControl
    x:Class="PrintShopCompanion.App.Views.OrdersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PrintShopCompanion.App.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    FontFamily="{StaticResource AppFontFamily}">

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <DockPanel Margin="{StaticResource PageMargin}">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Orders" Style="{StaticResource PageTitleText}"/>
                    <TextBlock Text="Manage customer print orders — updates live with the dashboard"
                               Style="{StaticResource PageSubtitleText}"/>
                </StackPanel>
                <Button Content="Refresh" Click="Refresh_Click" DockPanel.Dock="Right"
                        HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}"/>
            </DockPanel>
        </Border>

        <!-- Loading state: skeleton of the real layout -->
        <StackPanel Grid.Row="1" Margin="24,20"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Padding="20,14" Margin="0">
                <StackPanel>
                    <Border Style="{StaticResource SkeletonBar}" Width="160"/>
                    <Border Style="{StaticResource SkeletonBar}" Width="520" Margin="0,14,0,0"/>
                    <Border Style="{StaticResource SkeletonBar}" Width="480"/>
                    <Border Style="{StaticResource SkeletonBar}" Width="560"/>
                    <Border Style="{StaticResource SkeletonBar}" Width="500"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Error state: names the problem and the recovery -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
            <Border Style="{StaticResource EmptyStateGlyph}" Background="{DynamicResource DangerSoftBrush}" Margin="0,0,0,12">
                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFontFamily}" FontSize="20"
                           Foreground="{DynamicResource DangerBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Could not load orders" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding ErrorMessage}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16" MaxWidth="360"/>
            <Button Content="Retry" Click="Refresh_Click"
                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Orders content -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="24,20,24,24"
                Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel>
                <!-- Filter row — FUNCTIONAL chips (they actually filter the list) -->
                <Border Background="{DynamicResource SubsurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                        Padding="20,14">
                    <DockPanel>
                        <TextBlock Text="Order queue" Style="{StaticResource CardTitleText}"
                                   DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Orders.Count, StringFormat={}{0} orders}"
                                   Style="{StaticResource MutedText}"
                                   DockPanel.Dock="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <ItemsControl DockPanel.Dock="Right" ItemsSource="{x:Static vm:OrdersViewModel.FilterOptions}"
                                      HorizontalAlignment="Right">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="Filter_Click" Tag="{Binding}" Margin="4,0,0,0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="12" Padding="12,5"
                                                        BorderBrush="Transparent" BorderThickness="1">
                                                    <Border.Background>
                                                        <MultiBinding Converter="{StaticResource ChipBg}">
                                                            <Binding/>
                                                            <Binding Path="DataContext.SelectedFilter"
                                                                     RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                        </MultiBinding>
                                                    </Border.Background>
                                                    <TextBlock x:Name="T" Text="{Binding}" FontSize="11">
                                                        <TextBlock.Foreground>
                                                            <MultiBinding Converter="{StaticResource ChipFg}">
                                                                <Binding/>
                                                                <Binding Path="DataContext.SelectedFilter"
                                                                         RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                            </MultiBinding>
                                                        </TextBlock.Foreground>
                                                    </TextBlock>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush"
                                                                Value="{DynamicResource FocusRingBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!-- Table header row -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1"
                        Padding="20,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Token" Style="{StaticResource ColumnHeaderText}"/>
                        <TextBlock Grid.Column="1" Text="Customer" Style="{StaticResource ColumnHeaderText}"/>
                        <TextBlock Grid.Column="2" Text="Status" Style="{StaticResource ColumnHeaderText}"/>
                        <TextBlock Grid.Column="3" Text="Amount" Style="{StaticResource ColumnHeaderText}"/>
                        <TextBlock Grid.Column="4" Text="Date" Style="{StaticResource ColumnHeaderText}"/>
                    </Grid>
                </Border>

                <ListView ItemsSource="{Binding Orders}" Background="Transparent" BorderThickness="0"
                          x:Name="OrdersList">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="20,12"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource BrandSofterBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid MouseLeftButtonUp="Row_Click" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding TokenNumber, FallbackValue='—'}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding CustomerPhone, FallbackValue='—'}"
                                           FontSize="13" Foreground="{DynamicResource TextBodyBrush}" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Style="{StaticResource StatusPill}" HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{Binding Status, Converter={StaticResource StatusBg}}"
                                        BorderBrush="{Binding Status, Converter={StaticResource StatusBorder}}"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusLabel}}"
                                               Style="{StaticResource StatusPillText}"
                                               Foreground="{Binding Status, Converter={StaticResource StatusFg}}"/>
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding TotalAmountPaise, Converter={StaticResource Rupees}}"
                                           FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding CreatedAt, Converter={StaticResource LocalTime}}"
                                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty state: explains where orders come from. Filter-aware
                     copy: when a filter is active the list may be empty while
                     the queue is not. -->
                <StackPanel HorizontalAlignment="Center" Margin="0,40"
                            Visibility="{Binding Orders.Count, Converter={StaticResource ZeroToVis}}">
                    <Border Style="{StaticResource EmptyStateGlyph}" Margin="0,0,0,10">
                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFontFamily}" FontSize="18"
                                   Foreground="{DynamicResource BrandDarkBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="No orders to show" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Orders appear here the moment a customer checks out — try the All filter if you have a status selected."
                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" MaxWidth="380" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
