<UserControl
    x:Class="PrintShopCompanion.App.Views.OrdersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    FontFamily="Segoe UI">

    <Grid Background="#F7F7F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <DockPanel Margin="24,18,24,18">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Orders" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="Manage customer print orders" FontSize="12.5"
                               Foreground="#6B7280" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Content="↻  Refresh" Click="Refresh_Click" DockPanel.Dock="Right"
                        HorizontalAlignment="Right" Padding="16,9" FontSize="13"
                        Background="#FFFFFF" Foreground="#374151" BorderBrush="#E5E7EB"
                        BorderThickness="1" Cursor="Hand" FontWeight="Medium"/>
            </DockPanel>
        </Border>

        <!-- Loading state -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Loading orders..." FontSize="14" Foreground="#6B7280"/>
        </StackPanel>

        <!-- Error state -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
            <Border Width="48" Height="48" CornerRadius="24" Background="#FEF2F2" Margin="0,0,0,12">
                <TextBlock Text="⚠" FontSize="22" Foreground="#DC2626"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Could not load orders" FontSize="16" FontWeight="SemiBold"
                       Foreground="#111827" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding ErrorMessage}" FontSize="13" Foreground="#6B7280"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16" MaxWidth="360"/>
            <Button Content="Retry" Click="Refresh_Click" Padding="20,10"
                    Background="#D97706" Foreground="White"
                    BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Orders content -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="10" BorderBrush="#E5E7EB"
                BorderThickness="1" Margin="24,20"
                Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel>
                <!-- Filter row -->
                <Border Background="#FAFAFA" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"
                        Padding="20,14">
                    <DockPanel>
                        <TextBlock Text="Order Queue" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#111827" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Orders.Count, StringFormat={}{0} orders}"
                                   FontSize="12" Foreground="#6B7280"
                                   DockPanel.Dock="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- Filter chips (visual only) -->
                            <Border Background="#FEF3C7" CornerRadius="12" Padding="12,4" Margin="0,0,8,0">
                                <TextBlock Text="All" FontSize="11" FontWeight="Medium" Foreground="#92400E"/>
                            </Border>
                            <Border Background="#F3F4F6" CornerRadius="12" Padding="12,4" Margin="0,0,8,0">
                                <TextBlock Text="Pending" FontSize="11" Foreground="#374151"/>
                            </Border>
                            <Border Background="#F3F4F6" CornerRadius="12" Padding="12,4" Margin="0,0,8,0">
                                <TextBlock Text="Printing" FontSize="11" Foreground="#374151"/>
                            </Border>
                            <Border Background="#F3F4F6" CornerRadius="12" Padding="12,4">
                                <TextBlock Text="Ready" FontSize="11" Foreground="#374151"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Table header row -->
                <Border Background="#FFFFFF" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1"
                        Padding="20,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="TOKEN" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                        <TextBlock Grid.Column="1" Text="CUSTOMER" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                        <TextBlock Grid.Column="2" Text="STATUS" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                        <TextBlock Grid.Column="3" Text="AMOUNT" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                        <TextBlock Grid.Column="4" Text="DATE" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                    </Grid>
                </Border>

                <ListView ItemsSource="{Binding Orders}" Background="Transparent" BorderThickness="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="20,12"/>
                            <Setter Property="BorderBrush" Value="#F3F4F6"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding TokenNumber}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#111827"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding CustomerPhone}"
                                           FontSize="13" Foreground="#374151" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="#FEF3C7" CornerRadius="10"
                                        Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Medium"
                                               Foreground="#92400E"/>
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding TotalAmountPaise}"
                                           FontSize="13" FontWeight="Medium" Foreground="#111827"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}"
                                           FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center" Margin="0,40"
                            Visibility="{Binding Orders.Count, Converter={StaticResource InverseBoolToVis}}">
                    <Border Width="56" Height="56" CornerRadius="28" Background="#F3F4F6" Margin="0,0,0,12">
                        <TextBlock Text="📋" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="No orders found" FontSize="14" FontWeight="Medium"
                               Foreground="#111827" HorizontalAlignment="Center"/>
                    <TextBlock Text="Orders from your shop will appear here"
                               FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
