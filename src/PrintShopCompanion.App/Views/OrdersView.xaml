<UserControl
    x:Class="PrintShopCompanion.App.Views.OrdersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PrintShopCompanion.App.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    FontFamily="Segoe UI">

    <Grid Background="#F7F7F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <DockPanel Margin="24,18,24,18">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Orders" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="Manage customer print orders — updates live with the dashboard"
                               FontSize="12.5" Foreground="#6B7280" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Content="↻  Refresh" Click="Refresh_Click" DockPanel.Dock="Right"
                        HorizontalAlignment="Right" Padding="16,9" FontSize="13"
                        Background="#FFFFFF" Foreground="#374151" BorderBrush="#E5E7EB"
                        BorderThickness="1" Cursor="Hand" FontWeight="Medium"/>
            </DockPanel>
        </Border>

        <!-- Loading state -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Loading orders..." FontSize="14" Foreground="#6B7280"/>
        </StackPanel>

        <!-- Error state -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
            <Border Width="48" Height="48" CornerRadius="24" Background="#FFE7E4" Margin="0,0,0,12">
                <TextBlock Text="⚠" FontSize="22" Foreground="#BE222A"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Could not load orders" FontSize="16" FontWeight="SemiBold"
                       Foreground="#111827" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding ErrorMessage}" FontSize="13" Foreground="#6B7280"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16" MaxWidth="360"/>
            <Button Content="Retry" Click="Refresh_Click" Padding="20,10"
                    Background="#2858CD" Foreground="White"
                    BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Orders content -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="10" BorderBrush="#E5E7EB"
                BorderThickness="1" Margin="24,20"
                Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel>
                <!-- Filter row — FUNCTIONAL chips (they actually filter the list) -->
                <Border Background="#FAFAFA" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"
                        Padding="20,14">
                    <DockPanel>
                        <TextBlock Text="Order Queue" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#111827" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Orders.Count, StringFormat={}{0} orders}"
                                   FontSize="12" Foreground="#6B7280"
                                   DockPanel.Dock="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <ItemsControl DockPanel.Dock="Right" ItemsSource="{x:Static vm:OrdersViewModel.FilterOptions}"
                                      HorizontalAlignment="Right">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="Filter_Click" Tag="{Binding}" Margin="4,0,0,0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="12" Padding="12,4"
                                                        BorderBrush="Transparent" BorderThickness="1">
                                                    <Border.Background>
                                                        <MultiBinding Converter="{StaticResource ChipBg}">
                                                            <Binding/>
                                                            <Binding Path="DataContext.SelectedFilter"
                                                                     RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                        </MultiBinding>
                                                    </Border.Background>
                                                    <TextBlock x:Name="T" Text="{Binding}" FontSize="11">
                                                        <TextBlock.Foreground>
                                                            <MultiBinding Converter="{StaticResource ChipFg}">
                                                                <Binding/>
                                                                <Binding Path="DataContext.SelectedFilter"
                                                                         RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                            </MultiBinding>
                                                        </TextBlock.Foreground>
                                                    </TextBlock>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!-- Table header row -->
                <Border Background="#FFFFFF" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1"
                        Padding="20,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="TOKEN" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                        <TextBlock Grid.Column="1" Text="CUSTOMER" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                        <TextBlock Grid.Column="2" Text="STATUS" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                        <TextBlock Grid.Column="3" Text="AMOUNT" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                        <TextBlock Grid.Column="4" Text="DATE" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                    </Grid>
                </Border>

                <ListView ItemsSource="{Binding Orders}" Background="Transparent" BorderThickness="0"
                          x:Name="OrdersList">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="20,12"/>
                            <Setter Property="BorderBrush" Value="#F3F4F6"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F7FAFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid MouseLeftButtonUp="Row_Click" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding TokenNumber, FallbackValue='—'}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#111827"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding CustomerPhone, FallbackValue='—'}"
                                           FontSize="13" Foreground="#374151" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{Binding Status, Converter={StaticResource StatusBg}}"
                                        BorderBrush="{Binding Status, Converter={StaticResource StatusBorder}}"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusLabel}}"
                                               FontSize="11" FontWeight="Medium"
                                               Foreground="{Binding Status, Converter={StaticResource StatusFg}}"/>
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding TotalAmountPaise, Converter={StaticResource Rupees}}"
                                           FontSize="13" FontWeight="Medium" Foreground="#111827"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding CreatedAt, Converter={StaticResource LocalTime}}"
                                           FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center" Margin="0,40"
                            Visibility="{Binding Orders.Count, Converter={StaticResource InverseBoolToVis}}">
                    <Border Width="56" Height="56" CornerRadius="28" Background="#F3F4F6" Margin="0,0,0,12">
                        <TextBlock Text="📋" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="No orders found" FontSize="14" FontWeight="Medium"
                               Foreground="#111827" HorizontalAlignment="Center"/>
                    <TextBlock Text="Orders from your shop will appear here as they come in"
                               FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
