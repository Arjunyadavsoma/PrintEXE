<UserControl
 x:Class="PrintShopCompanion.App.Views.SetupView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:PrintShopCompanion.App.ViewModels"
 d:DataContext="{d:DesignInstance vm:SetupViewModel}"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 mc:Ignorable="d"
 FontFamily="{StaticResource AppFontFamily}">

 <ScrollViewer VerticalScrollBarVisibility="Auto">
 <StackPanel MaxWidth="640" HorizontalAlignment="Stretch" Margin="24,20,24,24">
 <TextBlock Text="Setup" Style="{StaticResource PageTitleText}" Margin="0,0,0,8" />
 <TextBlock Text="Connect this PC to your PrintShop in three steps." Style="{StaticResource PageSubtitleText}" Margin="0,0,0,24" />

 <!-- Step indicator: numbered steps ARE a real sequence, so markers are
      earned (craft-floor: sequence markers only when the content is a
      sequence). -->
 <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
 <TextBlock Text="1" FontSize="11" Foreground="{DynamicResource BrandDarkBrush}" Margin="0,0,6,0" />
 <TextBlock Text="Welcome" Margin="0,0,20,0" Style="{StaticResource BodyText}" />
 <TextBlock Text="2" FontSize="11" Foreground="{DynamicResource BrandDarkBrush}" Margin="0,0,6,0" />
 <TextBlock Text="Pair with shop" Margin="0,0,20,0" Style="{StaticResource BodyText}" />
 <TextBlock Text="3" FontSize="11" Foreground="{DynamicResource BrandDarkBrush}" Margin="0,0,6,0" />
 <TextBlock Text="Done" Style="{StaticResource BodyText}" />
 </StackPanel>

 <Border Style="{StaticResource Card}">
 <StackPanel>
 <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" Foreground="{DynamicResource TextPrimaryBrush}"
 Text="{Binding CurrentStep, StringFormat='Step {0}'}" />
 <TextBlock TextWrapping="Wrap" Margin="0,0,0,16" Style="{StaticResource BodyText}" Text="{Binding StatusText}" />

 <Button Style="{StaticResource PrimaryButton}"
 Content="Begin pairing"
 Command="{Binding BeginPairingCommand}"
 Visibility="{Binding IsWaitingForMagicLink, Converter={StaticResource InverseBoolToVis}}" />

 <StackPanel Visibility="{Binding IsWaitingForMagicLink, Converter={StaticResource BoolToVis}}">
 <ProgressBar IsIndeterminate="True" Height="6" Margin="0,0,0,12" />
 <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Command="{Binding CancelPairingCommand}" />
 </StackPanel>

 <!-- Error: names the problem, near the action that caused it -->
 <TextBlock Foreground="{DynamicResource DangerBrush}" Margin="0,12,0,0" Style="{StaticResource BodyText}"
            Text="{Binding LastError}" TextWrapping="Wrap"
            Visibility="{Binding LastError, Converter={StaticResource StringToVis}}"/>
 </StackPanel>
 </Border>

 <TextBlock Style="{StaticResource MutedText}" Margin="0,12,0,0" FontSize="11"
 Text="No pairing codes to type. The website sends a one-time link that this app accepts automatically." />
 </StackPanel>
 </ScrollViewer>
</UserControl>
