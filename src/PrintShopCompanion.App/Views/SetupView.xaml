<UserControl
 x:Class="PrintShopCompanion.App.Views.SetupView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:PrintShopCompanion.App.ViewModels"
 d:DataContext="{d:DesignInstance vm:SetupViewModel}"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 mc:Ignorable="d">

 <ScrollViewer VerticalScrollBarVisibility="Auto">
 <StackPanel MaxWidth="640" HorizontalAlignment="Stretch">
 <TextBlock Text="Setup" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8" />
 <TextBlock Text="Connect this PC to your PrintShop in three steps." Opacity="0.7" Margin="0,0,0,24" />

 <!-- Step indicator -->
 <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
 <TextBlock Text="●" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,6,0" />
 <TextBlock Text="Welcome" Margin="0,0,20,0" />
 <TextBlock Text="●" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,6,0" />
 <TextBlock Text="Pair with shop" Margin="0,0,20,0" />
 <TextBlock Text="●" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,6,0" />
 <TextBlock Text="Done" />
 </StackPanel>

 <Border Style="{StaticResource Card}">
 <StackPanel>
 <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"
 Text="{Binding CurrentStep, StringFormat='Step {0}'}" />
 <TextBlock TextWrapping="Wrap" Margin="0,0,0,16" Text="{Binding StatusText}" />

 <Button Style="{StaticResource PrimaryButton}"
 Content="Begin pairing"
 Command="{Binding BeginPairingCommand}"
 Visibility="{Binding IsWaitingForMagicLink, Converter={StaticResource InverseBoolToVis}}" />

 <StackPanel Visibility="{Binding IsWaitingForMagicLink, Converter={StaticResource BoolToVis}}">
 <ProgressBar IsIndeterminate="True" Height="6" Margin="0,0,0,12" />
 <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Command="{Binding CancelPairingCommand}" />
 </StackPanel>

 <TextBlock Foreground="{DynamicResource BrandDangerBrush}" Margin="0,12,0,0" Text="{Binding LastError}" />
 </StackPanel>
 </Border>

 <TextBlock Opacity="0.55" Margin="0,12,0,0" FontSize="11"
 Text="No pairing codes to type. The website sends a one-time link that this app accepts automatically." />
 </StackPanel>
 </ScrollViewer>
</UserControl>
