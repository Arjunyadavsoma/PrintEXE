<UserControl
    x:Class="PrintShopCompanion.App.Views.PrintersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="24,24,24,0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Printers" FontSize="22" FontWeight="Bold" Foreground="#1F2937"/>
                <TextBlock Text="Installed printers on this computer" FontSize="13" Foreground="#6B7280" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Refresh" Click="Refresh_Click" Padding="16,8" FontSize="13"
                        Background="#F3F4F6" Foreground="#374151" BorderBrush="#E5E7EB"
                        BorderThickness="1" Cursor="Hand" Margin="0,0,8,0"/>
                <Button Content="Test Print" Click="TestPrint_Click" Padding="16,8" FontSize="13"
                        Background="#D97706" Foreground="White" BorderThickness="0"
                        FontWeight="SemiBold" Cursor="Hand"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#E5E7EB"
                BorderThickness="1" Margin="24" Padding="20">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="" FontSize="13" Margin="0,0,0,12" Foreground="#6B7280"/>
                <ListView x:Name="PrinterList" Background="Transparent" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="250" DisplayMemberBinding="{Binding DisplayName}"/>
                            <GridViewColumn Header="Status" Width="100" DisplayMemberBinding="{Binding IsOffline}"/>
                            <GridViewColumn Header="Default" Width="80" DisplayMemberBinding="{Binding IsDefault}"/>
                            <GridViewColumn Header="Selected" Width="80" DisplayMemberBinding="{Binding IsSelected}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock Text="No printers found" FontSize="13" Foreground="#6B7280"
                           HorizontalAlignment="Center" Margin="0,20"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
