<UserControl
    x:Class="PrintShopCompanion.App.Views.PrintersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    FontFamily="{StaticResource AppFontFamily}">

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <DockPanel Margin="{StaticResource PageMargin}">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Printers" Style="{StaticResource PageTitleText}"/>
                    <TextBlock Text="Installed printers on this computer"
                               Style="{StaticResource PageSubtitleText}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Refresh" Click="Refresh_Click" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0"/>
                    <Button Content="Test print" Click="TestPrint_Click" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Printers list -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,24">
                <!-- Status line -->
                <Border Style="{StaticResource Card}" Padding="20,12" Margin="0,0,0,16"
                        Visibility="{Binding TestStatus, Converter={StaticResource StringToVis}}">
                    <TextBlock x:Name="StatusText" Text="{Binding TestStatus}" Style="{StaticResource BodyText}"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Section heading -->
                <TextBlock Text="Available printers" Style="{StaticResource SectionHeadingText}"/>

                <!-- Printer cards — selectable list with native selection
                     visuals: full border + brand ring on selection/hover. -->
                <ListView x:Name="PrinterList"
                          Background="Transparent" BorderThickness="0"
                          ItemsSource="{Binding Printers}"
                          SelectedItem="{Binding Selected, Mode=TwoWay}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,10"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Bd" Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="{StaticResource CardRadius}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandBorderBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="20,16">
                                <!-- Status dot -->
                                <Border Style="{StaticResource StatusDot}"
                                        Background="{DynamicResource SuccessBrush}"
                                        DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CardTitleText}"/>
                                    <TextBlock Text="{Binding FullName}" FontSize="11.5"
                                               Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0" MaxWidth="450"/>
                                </StackPanel>

                                <!-- Badges -->
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Style="{StaticResource StatusPill}" Background="{DynamicResource BrandSoftBrush}"
                                            Margin="0,0,6,0" Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Windows default" Style="{StaticResource StatusPillText}"
                                                   Foreground="{DynamicResource BrandDarkBrush}"/>
                                    </Border>
                                    <Border Style="{StaticResource StatusPill}" Background="{DynamicResource BrandBrush}"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Selected" Style="{StaticResource StatusPillText}"
                                                   Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty state: names the fix, not just the gap -->
                <StackPanel HorizontalAlignment="Center" Margin="0,40"
                            Visibility="{Binding Printers.Count, Converter={StaticResource ZeroToVis}}">
                    <Border Style="{StaticResource EmptyStateGlyph}" Margin="0,0,0,10">
                        <TextBlock Text="&#xE749;" FontFamily="{StaticResource IconFontFamily}" FontSize="18"
                                   Foreground="{DynamicResource BrandDarkBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="No printers found" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Install at least one Windows printer (Settings → Bluetooth &amp; devices → Printers &amp; scanners), then refresh."
                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" MaxWidth="380" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
