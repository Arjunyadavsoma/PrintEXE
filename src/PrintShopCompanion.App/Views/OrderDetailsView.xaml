<UserControl
    x:Class="PrintShopCompanion.App.Views.OrderDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    FontFamily="{StaticResource AppFontFamily}">

    <UserControl.Resources>
        <!-- Per-file color-mode pill -->
        <Style x:Key="FileModePill" TargetType="Border" BasedOn="{StaticResource StatusPill}">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ColorMode}" Value="color">
                    <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <DockPanel Margin="{StaticResource PageMargin}">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="&#xE72B;&#xFE0E; Back" Click="Back_Click" VerticalAlignment="Center"
                            Style="{StaticResource SecondaryButton}"
                            FontFamily="{StaticResource AppFontFamily}"/>
                    <TextBlock Text="{Binding Order.TokenNumber, StringFormat=Token {0}}"
                               Style="{StaticResource PageTitleText}"
                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <Border x:Name="StatusPill" Style="{StaticResource StatusPill}" Padding="12,4"
                            Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusPillText" FontSize="11.5" FontWeight="Medium"/>
                    </Border>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Start printing" Click="Start_Click" x:Name="StartButton"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                    <Button Content="Mark completed" Click="Complete_Click" x:Name="CompleteButton"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                            Background="{DynamicResource SuccessBrush}"/>
                    <Button Content="Cancel order" Click="Cancel_Click" x:Name="CancelButton"
                            Style="{StaticResource DangerButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Loading state: skeleton of the detail layout -->
        <StackPanel Grid.Row="1" Margin="24,20"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <WrapPanel Margin="0,0,0,20">
                <Border Style="{StaticResource StatCard}" MinHeight="96"/>
                <Border Style="{StaticResource StatCard}" MinHeight="96"/>
                <Border Style="{StaticResource StatCard}" MinHeight="96" Margin="0"/>
            </WrapPanel>
            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0">
                <StackPanel>
                    <Border Style="{StaticResource SkeletonBar}" Width="420"/>
                    <Border Style="{StaticResource SkeletonBar}" Width="360"/>
                    <Border Style="{StaticResource SkeletonBar}" Width="400"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Error state -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
            <Border Style="{StaticResource EmptyStateGlyph}" Background="{DynamicResource DangerSoftBrush}" Margin="0,0,0,12">
                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFontFamily}" FontSize="20"
                           Foreground="{DynamicResource DangerBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Could not load this order" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding ErrorMessage}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16" MaxWidth="420"/>
            <Button Content="Retry" Click="Retry_Click"
                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel Margin="24,20,24,24">

                <!-- KPI row: tinted labels replace the left accent strips -->
                <WrapPanel Margin="0,0,0,20">
                    <Border Style="{StaticResource StatCard}" Width="210">
                        <StackPanel>
                            <TextBlock Text="Amount" Style="{StaticResource KpiLabel}" Foreground="{DynamicResource BrandDarkBrush}"/>
                            <TextBlock Text="{Binding AmountFormatted}" Style="{StaticResource KpiValue}"/>
                            <TextBlock Text="{Binding Order.PaymentProvider, StringFormat=via {0}, FallbackValue='payment'}"
                                       Style="{StaticResource KpiSub}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatCard}" Width="210">
                        <StackPanel>
                            <TextBlock Text="Customer" Style="{StaticResource KpiLabel}"/>
                            <TextBlock Text="{Binding Order.CustomerPhone, FallbackValue='—'}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding Order.CreatedAt, StringFormat=placed {0:yyyy-MM-dd HH:mm}}"
                                       Style="{StaticResource KpiSub}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatCard}" Width="210">
                        <StackPanel>
                            <TextBlock Text="Files" Style="{StaticResource KpiLabel}" Foreground="{DynamicResource InfoBrush}"/>
                            <TextBlock Text="{Binding Files.Count, StringFormat={}{0} file(s)}" Style="{StaticResource KpiValue}"/>
                            <TextBlock Text="download to reprint locally" Style="{StaticResource KpiSub}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Files table -->
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,20">
                    <StackPanel>
                        <Border Background="{DynamicResource SubsurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
                            <TextBlock Text="Files &amp; print settings" Style="{StaticResource CardTitleText}"/>
                        </Border>
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="20,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="File" Style="{StaticResource ColumnHeaderText}"/>
                                <TextBlock Grid.Column="1" Text="Pages" Style="{StaticResource ColumnHeaderText}"/>
                                <TextBlock Grid.Column="2" Text="Range" Style="{StaticResource ColumnHeaderText}"/>
                                <TextBlock Grid.Column="3" Text="Mode" Style="{StaticResource ColumnHeaderText}"/>
                                <TextBlock Grid.Column="4" Text="Paper" Style="{StaticResource ColumnHeaderText}"/>
                                <TextBlock Grid.Column="5" Text="" Style="{StaticResource ColumnHeaderText}"/>
                            </Grid>
                        </Border>
                        <ListView ItemsSource="{Binding Files}" Background="Transparent" BorderThickness="0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="20,10"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OriginalFilename}" FontSize="13" FontWeight="Medium"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SizeBytes, StringFormat={}{0:N0} bytes}"
                                                       FontSize="11" Foreground="{DynamicResource TextSubtleBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Copies, StringFormat={}{0}×}" FontSize="13"
                                                   Foreground="{DynamicResource TextBodyBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding PageRange, FallbackValue=all}" FontSize="13"
                                                   Foreground="{DynamicResource TextBodyBrush}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="3" Style="{StaticResource FileModePill}">
                                            <TextBlock Text="{Binding ColorMode}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StatusPillText}">
                                                        <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ColorMode}" Value="color">
                                                                <Setter Property="Foreground" Value="{DynamicResource BrandDarkBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Grid.Column="4" Text="{Binding PaperSize}" FontSize="13"
                                                   Foreground="{DynamicResource TextBodyBrush}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="5" Content="Download" Click="DownloadFile_Click"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="10,6" FontSize="12"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel HorizontalAlignment="Center" Margin="0,20"
                                    Visibility="{Binding Files.Count, Converter={StaticResource ZeroToVis}}">
                            <TextBlock Text="No files on this order" Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Files appear here once the customer uploads them on the web dashboard."
                                       FontSize="11" Foreground="{DynamicResource TextSubtleBrush}"
                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Notes editor -->
                <Border Style="{StaticResource Card}" Padding="0">
                    <StackPanel Margin="20,16">
                        <TextBlock Text="Internal notes" Style="{StaticResource SectionHeadingText}" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="70" VerticalScrollBarVisibility="Auto"
                                 FontSize="13" Padding="10"
                                 Style="{StaticResource InputField}"
                                 Background="{DynamicResource SubsurfaceBrush}"
                                 ToolTip="Notes stay on this computer — they are not sent to the web dashboard"/>
                        <Button Content="Save notes" Click="SaveNotes_Click" x:Name="SaveNotesButton"
                                HorizontalAlignment="Right" Margin="0,10,0,0"
                                Style="{StaticResource PrimaryButton}" Padding="14,8" FontSize="12.5"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
