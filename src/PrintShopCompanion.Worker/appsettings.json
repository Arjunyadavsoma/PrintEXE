{
  "Backend": {
    "BaseUrl": "https://printelyx.cc.cd",
    "ApiBasePath": "/api/v1",
    "SocketIoUrl": "https://printelyx.cc.cd/?XTransformPort=3003",
    "HubPath": "/?XTransformPort=3003",
    "HeartbeatInterval": "00:00:15",
    "HeartbeatIntervalSeconds": 15,
    "PollFallbackInterval": "00:00:03",
    "PollIntervalSeconds": 3,
    "AllowedWebOrigins": [ "https://printelyx.cc.cd" ],
    "DownloadTimeout": "00:05:00",
    "DownloadTimeoutSeconds": 300,
    "BypassTlsVerification": false
  },
  "PrintShop": {
    "BaseUrl": "https://printelyx.cc.cd",
    "PollingInterval": "00:00:03",
    "HeartbeatInterval": "00:00:15",
    "SocketIoUrl": "https://printelyx.cc.cd/?XTransformPort=3003",
    "DeviceTokenPath": null
  },
  "Printer": {
    "SelectedPrinter": null,
    "Renderer": "sumatra",
    "FallbackRenderers": [ "gdi" ],
    "SumatraExePath": null,
    "PrintConfirmTimeout": "00:05:00",
    "MaxAttempts": 5
  },
  "Storage": {
    "QueueDbPath": null,
    "PdfCacheDir": null,
    "LogDir": null,
    "TerminalJobTtl": "7.00:00:00"
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "File", "Args": { "path": "%APPDATA%/PrintShop/Companion/logs/worker-.log", "rollingInterval": "Day", "retainedFileCountLimit": 14 } },
      { "Name": "EventLog", "Args": { "source": "PrintShop Companion Worker", "logName": "Application" } }
    ]
  }
}
