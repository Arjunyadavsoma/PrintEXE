{
  "Backend": {
    "BaseUrl": "https://mock.printshop.local",
    "ApiBasePath": "/api/companion/v1",
    "HubPath": "/companion-hub",
    "HeartbeatInterval": "00:01:00",
    "PollFallbackInterval": "00:00:02",
    "AllowedWebOrigins": [],
    "DownloadTimeout": "00:02:00",
    "BypassTlsVerification": false
  },
  "Printer": {
    "SelectedPrinter": null,
    "Renderer": "sumatra",
    "FallbackRenderers": [ "gdi" ],
    "SumatraExePath": null,
    "PrintConfirmTimeout": "00:05:00",
    "MaxAttempts": 5
  },
  "Storage": {
    "QueueDbPath": null,
    "PdfCacheDir": null,
    "LogDir": null,
    "TerminalJobTtl": "7.00:00:00"
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "File", "Args": { "path": "%APPDATA%/PrintShop/Companion/logs/worker-.log", "rollingInterval": "Day", "retainedFileCountLimit": 14 } },
      { "Name": "EventLog", "Args": { "source": "PrintShop Companion Worker", "logName": "Application" } }
    ]
  }
}
