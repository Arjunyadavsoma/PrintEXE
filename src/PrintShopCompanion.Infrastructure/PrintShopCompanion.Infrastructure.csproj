<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-targeted (see Directory.Build.props): net10.0 for platform-neutral
         test execution, net10.0-windows for the full Windows surface. -->
    <RootNamespace>PrintShopCompanion.Infrastructure</RootNamespace>
    <AssemblyName>PrintShopCompanion.Infrastructure</AssemblyName>
    <!-- System.Printing and System.Drawing.Printing live in the Windows Desktop
         framework (Microsoft.WindowsDesktop.App). UseWPF=true brings them in
         without forcing a hard dependency on WPF UI assemblies — Infrastructure
         itself never opens a Window, but it does enumerate PrintQueues and
         submit PrintDocuments. Only set on the windows TFM so the neutral
         net10.0 build has no WindowsDesktop dependency at all. -->
    <UseWPF Condition="'$(TargetFramework)' == 'net10.0-windows'">true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

  <!-- Windows-only sources: System.Printing / System.Drawing.Printing are
       unavailable on the neutral TFM. Excluded there; compiled on windows. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="Printers/WindowsPrinterService.cs" />
    <Compile Remove="Printers/RawGdiPrinter.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- v0.7.2 fix: use the CORE package, NOT the meta Microsoft.Data.Sqlite.
         The meta package drags in SQLitePCLRaw.bundle_e_sqlite3, which ships
         an assembly with the SAME identity as bundle_e_sqlcipher's
         (SQLitePCLRaw.batteries_v2.dll) but registers the PLAIN provider —
         two same-named batteries assemblies in one app make the provider
         selection undefined, and the plain one silently ignoring Password=
         was worse than a crash. Microsoft.Data.Sqlite.Core auto-registers
         NOTHING; SqlCipherInitializer sets the provider explicitly. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.2" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.EventLog" Version="4.0.0" />

    <!-- DPAPI (DeviceTokenStore / QueueKeyStore). Was previously resolved only
         transitively from the Windows Desktop SDK — an unverified compile risk
         flagged by the Phase 0 audit (docs/AUDIT.md §3). Now explicit. The
         API compiles on the neutral TFM but throws at runtime on non-Windows;
         callers guard with OperatingSystem.IsWindows(). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.2" />

    <!-- v0.7.15: explicit on the windows TFM so RawGdiPrinter (System.Drawing
         Bitmap/Graphics) cross-compiles on Linux too. Without it, the windows
         TFM resolves System.Drawing.Common from the WindowsDesktop framework
         facade whose ref set lacks the System.Private.Windows.GdiPlus friend
         assembly (CS0012: 'IGraphics' is defined in an assembly that is not
         referenced). The NuGet package's net10.0 asset carries the friend.
         Same assembly identity on Windows CI — no behavior change there. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.0"
                      Condition="'$(TargetFramework)' == 'net10.0-windows'" />

    <!-- SocketIOClient: bumped to 3.2.0 (the latest stable on NuGet as of 2024).
         3.2.0 multi-targets net6.0/net7.0/net8.0 — when consumed by net10.0 it
         picks the net8.0 TFM and uses the built-in System.Net.WebSockets.ClientWebSocket,
         so it no longer drags in System.Net.WebSockets.Client.Managed 1.0.x
         (which is what was pulling in the vulnerable Microsoft.NETCore.App 1.1.0
         and Microsoft.NETCore.Jit 1.1.0 transitive deps). -->
    <PackageReference Include="SocketIOClient" Version="3.1.2" />

    <!-- Explicit overrides for vulnerable transitive deps.

         NU1903 advisories that were surfacing:
           - Microsoft.NETCore.App 1.1.0  (GHSA-7mfr-774f-w5r9, GHSA-8884-xcr4-r68p)
           - Microsoft.NETCore.Jit   1.1.0 (GHSA-xcvr-qv8h-m7xw)
           - Newtonsoft.Json         9.0.1 (GHSA-5crp-9r3c-p9vr)
           - SQLitePCLRaw.lib.e_sqlite3 2.1.11 (GHSA-2m69-gcr7-jv3q)

         The first two are gone after the SocketIOClient 3.2.0 bump (they came
         via System.Net.WebSockets.Client.Managed). Newtonsoft.Json is pinned
         here to a safe version. The lib.e_sqlite3 pin that fixed GHSA-2m69-
         gcr7-jv3q is GONE in v0.7.2 — for two reasons: (1) Microsoft.Data.
         Sqlite.Core no longer pulls lib.e_sqlite3 into the graph at all, so
         the advisory is gone with it; (2) pinning lib.e_sqlite3 3.50.3 next
         to bundle_e_sqlcipher 2.1.11 shipped a plain-SQLite native alongside
         the SQLCipher one and contributed to the provider confusion that
         broke the encrypted queue on Windows (screenshots 2026-11-26). -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- v0.5: SQLCipher for at-rest encryption of queue.db. The bundle brings
         provider.e_sqlcipher (managed) + lib.e_sqlcipher (natives: e_sqlcipher.dll
         for win-x64, libe_sqlcipher.so for linux-x64 — verified in the NuGet
         cache). Version 2.1.11 is the latest stable; the 3.x line exists only
         for SQLitePCLRaw.lib.* packages, not bundles. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
    <PackageReference Include="SQLitePCLRaw.provider.e_sqlcipher" Version="2.1.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrintShopCompanion.Core\PrintShopCompanion.Core.csproj" />
    <ProjectReference Include="..\PrintShopCompanion.Shared\PrintShopCompanion.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expose internals (GitHubRelease, GitHubAsset, IsNewer) to the test
         project so the auto-update tests can verify the deserialization
         shape and the version comparison logic directly. -->
    <InternalsVisibleTo Include="PrintShopCompanion.Infrastructure.Tests" />
  </ItemGroup>

</Project>
