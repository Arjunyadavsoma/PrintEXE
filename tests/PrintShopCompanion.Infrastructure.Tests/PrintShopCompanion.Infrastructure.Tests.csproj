<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="FluentAssertions" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.2" />

    <!-- Vulnerable-transitive overrides — same as the production projects. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Phase 5: use the SQLCipher bundle (matching the app) so the
         encryption tests exercise the REAL provider. The previous explicit
         lib.e_sqlite3 reference loaded the plain provider in the testhost,
         which correctly made SqlCipherInitializer fail closed and made the
         SQLCipher plaintext test untestable. SQLCipher opens unencrypted
         databases transparently, so the keyStore:null (plaintext) suites
         are unaffected. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PrintShopCompanion.Core\PrintShopCompanion.Core.csproj" />
    <ProjectReference Include="..\..\src\PrintShopCompanion.Infrastructure\PrintShopCompanion.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\PrintShopCompanion.Shared\PrintShopCompanion.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
